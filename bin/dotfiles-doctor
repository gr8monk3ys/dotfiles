#!/usr/bin/env bash
# dotfiles-doctor - Check system health and configuration status

set -euo pipefail

# Default to the checkout this script lives in (works through symlinks), so
# running bin/dotfiles-* from any clone operates on that clone.
readonly DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/ui.sh
source "$SCRIPT_DIR/lib/ui.sh"

# Track overall health
ISSUES=0
WARNINGS=0

check_pass() {
    echo -e "${GREEN}✓${NC} $1"
}

check_fail() {
    echo -e "${RED}✗${NC} $1"
    ((++ISSUES))
}

check_warn() {
    echo -e "${YELLOW}⚠${NC} $1"
    ((++WARNINGS))
}

check_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check System Information
check_system() {
    print_header "System Information"

    if [[ "$OSTYPE" == "darwin"* ]]; then
        check_pass "Operating System: macOS $(sw_vers -productVersion)"

        # Check architecture
        if [[ $(uname -m) == "arm64" ]]; then
            check_pass "Architecture: Apple Silicon (ARM64)"
        else
            check_pass "Architecture: Intel (x86_64)"
        fi
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        check_pass "Operating System: Linux"
        check_info "Distribution: $(lsb_release -d 2>/dev/null | cut -f2 || echo 'Unknown')"
    else
        check_warn "Operating System: $OSTYPE (Limited support)"
    fi

    check_info "Shell: $SHELL"
    check_info "User: ${USER:-$(id -un)}"
    check_info "Home: $HOME"
}

# Check dotfiles repository
check_dotfiles() {
    print_header "Dotfiles Repository"

    if [[ -d "$DOTFILES_DIR" ]]; then
        check_pass "Dotfiles directory found: $DOTFILES_DIR"

        cd "$DOTFILES_DIR"

        # Check if it's a git repository
        if [[ -d ".git" ]]; then
            check_pass "Git repository initialized"

            # Check for uncommitted changes
            if [[ -n $(git status --porcelain) ]]; then
                check_warn "Uncommitted changes detected"
            else
                check_pass "Repository is clean"
            fi

            # Check remote
            if git remote -v | grep -q origin; then
                check_pass "Remote origin configured"
            else
                check_warn "No remote origin configured"
            fi
        else
            check_warn "Not a git repository"
        fi
    else
        check_fail "Dotfiles directory not found: $DOTFILES_DIR"
    fi
}

# Check symlinks
check_symlinks() {
    print_header "Symlink Status"

    # Check .zshenv
    if [[ -L "$HOME/.zshenv" ]]; then
        if [[ -e "$HOME/.zshenv" ]]; then
            check_pass ".zshenv symlink exists and valid"
        else
            check_fail ".zshenv symlink broken"
        fi
    else
        if [[ -f "$HOME/.zshenv" ]]; then
            check_warn ".zshenv exists but is not a symlink"
        else
            check_fail ".zshenv not found"
        fi
    fi

    # Check .config directory
    if [[ -d "$HOME/.config" ]]; then
        check_pass ".config directory exists"

        # Check common config symlinks (including new modern tools)
        local config_dirs=("zsh" "git" "nvim" "ghostty" "yazi" "zellij" "jj" "tmux")
        for dir in "${config_dirs[@]}"; do
            if [[ -e "$HOME/.config/$dir" ]]; then
                local is_linked=false
                if [[ -L "$HOME/.config/$dir" ]]; then
                    is_linked=true
                else
                    for f in "$HOME/.config/$dir"/*; do
                        if [[ -L "$f" ]]; then
                            is_linked=true
                            break
                        fi
                    done
                fi
                if $is_linked; then
                    check_pass ".config/$dir linked"
                else
                    check_warn ".config/$dir exists but may not be linked"
                fi
            fi
        done
    else
        check_fail ".config directory not found"
    fi
}

# Check package managers
check_package_managers() {
    print_header "Package Managers"

    # Homebrew
    if command_exists brew; then
        check_pass "Homebrew installed ($(brew --version | head -n1))"

        # Check for outdated packages
        outdated=$(brew outdated | wc -l | tr -d ' ')
        if [[ "$outdated" -gt 0 ]]; then
            check_warn "$outdated Homebrew packages need updating"
        else
            check_pass "All Homebrew packages up to date"
        fi
    else
        if [[ "$OSTYPE" == "darwin"* ]]; then
            check_fail "Homebrew not installed"
        else
            check_info "Homebrew not installed (macOS only)"
        fi
    fi

    # npm
    if command_exists npm; then
        check_pass "npm installed ($(npm --version))"
    else
        check_warn "npm not installed"
    fi

    # Cargo
    if command_exists cargo; then
        check_pass "Cargo installed ($(cargo --version | cut -d' ' -f2))"
    else
        check_warn "Cargo not installed"
    fi

    # pacman (Linux only; the repo ships a bin/pacman sudo wrapper that
    # would satisfy a bare command_exists check on macOS via make's PATH)
    if [[ "$OSTYPE" == "linux-gnu"* ]] && command_exists pacman; then
        check_pass "pacman installed"
    fi
}

# Check core tools
check_core_tools() {
    print_header "Core Tools"

    local tools=("git" "zsh" "nvim" "stow")

    for tool in "${tools[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool installed"
        else
            check_fail "$tool not installed"
        fi
    done
}

# Check modern CLI tools
check_modern_tools() {
    print_header "Modern CLI Tools"

    # Essential modern tools
    local essential=("eza" "bat" "fd" "rg" "zoxide" "fzf")
    for tool in "${essential[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool installed"
        else
            check_warn "$tool not installed (recommended)"
        fi
    done

    # Next-gen tools (optional but nice to have)
    local nextgen=("yazi" "zellij" "jj" "delta" "atuin")
    for tool in "${nextgen[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool installed"
        else
            check_info "$tool not installed (optional)"
        fi
    done

    # Additional modern tools
    local additional=("navi" "broot" "tldr" "gping" "ouch")
    for tool in "${additional[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool installed"
        else
            check_info "$tool not installed (optional)"
        fi
    done
}

# Check shell configuration
check_shell_config() {
    print_header "Shell Configuration"

    # Check if zsh is default shell
    if [[ "$SHELL" == *"zsh"* ]]; then
        check_pass "Zsh is default shell"
    else
        check_warn "Default shell is not zsh: $SHELL"
    fi

    # Check ZDOTDIR
    if [[ -n "${ZDOTDIR:-}" ]]; then
        check_pass "ZDOTDIR set: $ZDOTDIR"
    else
        check_warn "ZDOTDIR not set"
    fi

    # Check Zinit (plugin manager used by .zshrc; it self-installs on first run)
    if [[ -d "${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git" ]]; then
        check_pass "Zinit installed"
    else
        check_warn "Zinit not installed (will bootstrap on next zsh start)"
    fi
}

# Check file permissions
check_permissions() {
    print_header "File Permissions"

    # Check SSH directory
    if [[ -d "$HOME/.ssh" ]]; then
        local ssh_perms
        ssh_perms=$(stat -f "%Lp" "$HOME/.ssh" 2>/dev/null || stat -c "%a" "$HOME/.ssh" 2>/dev/null)
        if [[ "$ssh_perms" == "700" ]]; then
            check_pass ".ssh directory permissions: 700"
        else
            check_warn ".ssh directory permissions: $ssh_perms (should be 700)"
        fi
    fi

    # Check for private keys with wrong permissions
    if [[ -d "$HOME/.ssh" ]]; then
        while IFS= read -r key; do
            if [[ -f "$key" ]]; then
                local key_perms
                key_perms=$(stat -f "%Lp" "$key" 2>/dev/null || stat -c "%a" "$key" 2>/dev/null)
                if [[ "$key_perms" == "600" ]]; then
                    check_pass "$(basename "$key") permissions: 600"
                else
                    check_warn "$(basename "$key") permissions: $key_perms (should be 600)"
                fi
            fi
        done < <(find "$HOME/.ssh" -name "id_*" -not -name "*.pub" 2>/dev/null)
    fi
}

# Summary
print_summary() {
    print_header "Summary"

    echo ""
    if [[ $ISSUES -eq 0 && $WARNINGS -eq 0 ]]; then
        echo -e "${GREEN}✓ All checks passed! System is healthy.${NC}"
    else
        [[ $ISSUES -gt 0 ]] && echo -e "${RED}✗ $ISSUES issue(s) found${NC}"
        [[ $WARNINGS -gt 0 ]] && echo -e "${YELLOW}⚠ $WARNINGS warning(s) found${NC}"
    fi
    echo ""

    # Return non-zero if there are issues
    if [[ $ISSUES -gt 0 ]]; then
        return 1
    fi
    return 0
}

# Show help message
show_help() {
    cat << EOF
Usage: dotfiles-doctor [OPTIONS]

Comprehensive health check for dotfiles system and configurations.

OPTIONS:
    -h, --help      Show this help message
    -v, --verbose   Show verbose output (detailed checks)

DESCRIPTION:
    Checks system health including:
    - System information and platform
    - Dotfiles repository status
    - Symlink integrity
    - Package manager status
    - Core tool availability
    - Shell configuration
    - File permissions

EXIT CODES:
    0    All checks passed
    1    Issues found

EXAMPLES:
    dotfiles-doctor              Run health check
    dotfiles-doctor --help       Show this help
    dotfiles-doctor --verbose    Run with detailed output

EOF
}

# Main
main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                set -x
                shift
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done

    echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║                  Dotfiles Health Check                        ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"

    check_system
    check_dotfiles
    check_symlinks
    check_package_managers
    check_core_tools
    check_modern_tools
    check_shell_config
    check_permissions
    print_summary
}

main "$@"
