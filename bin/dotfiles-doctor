#!/usr/bin/env bash
# dotfiles-doctor - Check system health and configuration status
#
# One reporter over many classifiers (CONTEXT.md § Reporter). The pieces:
#
#   classifiers    one per section; each prints `state<TAB>subject<TAB>detail`
#                  rows and makes no judgement. bin/link-state, bin/dotfiles-init
#                  --status and lib/git-sync.sh plug in directly; the rest are
#                  small probes below.
#   DOCTOR_STATES  the one table mapping (vocabulary, state) to a severity and
#                  an optional note — usually the remedy.
#   report_row     the one printer; it also keeps the tally that decides the
#                  exit code.
#
# Before this, each of nine sections invented its own probe *and* its own
# output, three of them re-mapped a classifier's vocabulary with a private
# `case`, and the only test of that mapping was grepping this file for case
# arms. Now a state's severity is data (`dotfiles-doctor --states`), and a
# state no row maps is reported as a failure rather than dropped.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"
# shellcheck source=lib/ui.sh
source "$SCRIPT_DIR/lib/ui.sh"
# shellcheck source=lib/git-sync.sh
source "$SCRIPT_DIR/lib/git-sync.sh"

# Resolved once: bin/platform is an executable (the Makefile cannot source
# it), so cache the answer rather than forking per branch. Resolved from this
# script's own directory, not DOTFILES_DIR: DOTFILES_DIR is the checkout being
# inspected, which may be a fixture with no bin/.
PLATFORM="$SCRIPT_DIR/platform"
PLATFORM_OS="$("$PLATFORM" detect)"
readonly PLATFORM PLATFORM_OS

# The commands this health check probes, by severity. These are *command*
# names, not package names: `rg` ships in the `ripgrep` package. The mapping
# and the exemptions live in test/allowlist/command-packages.txt, and
# bin/validate-doctor-tools fails when these lists and the install manifests
# drift apart in either direction.
readonly DOCTOR_CORE_TOOLS=("git" "zsh" "nvim" "stow")
readonly DOCTOR_ESSENTIAL_TOOLS=("eza" "bat" "fd" "rg" "zoxide" "fzf")
readonly DOCTOR_NEXTGEN_TOOLS=("yazi" "zellij" "jj" "delta" "atuin")
readonly DOCTOR_ADDITIONAL_TOOLS=("navi" "broot" "tldr" "gping" "ouch")

# --- the state table ---------------------------------------------------------
#
# vocabulary  state  severity  note (the rest of the line; "-" for none)
#
# The note is printed after the detail, in parentheses: the remedy where
# there is one, otherwise what the state means.
#
# Severities: pass, info, warn, fail (counts as an issue, exits 1), skip
# (printed nothing). Missing tools and local config are warnings, never issues:
# `make link` installs and configures nothing, so a freshly linked box must
# still be able to pass.
#
# `sync` is every state lib/git-sync.sh can produce, including the two only
# git_sync_apply reaches: doctor never applies, but a mapping that silently
# lacks a state is how the old `case` came to cover three of ten.
DOCTOR_STATES="$(
    cat << 'EOF'
platform supported             pass -
platform unsupported           warn limited support
platform fact                  info -
sync     missing-dir           fail clone it, or point DOTFILES_DIR at a checkout
sync     not-a-repo            warn -
sync     dirty                 warn -
sync     no-upstream           warn this checkout can never sync
sync     fetch-failed          warn -
sync     clean-uptodate        pass -
sync     clean-behind          warn run 'dotfiles-update'
sync     diverged              warn merge by hand
sync     pulled                pass -
sync     pull-failed           warn resolve the pull by hand
link     linked                pass -
link     partial               fail run 'make link'
link     unlinked              fail run 'make link'
link     unmanaged             warn exists, but is not linked into this checkout
link     broken-ours           fail run 'make clean'
link     broken-foreign        skip -
manager  runs                  pass -
manager  current               pass -
manager  outdated              warn run 'dotfiles-update'
manager  missing               warn -
manager  required-missing      fail -
manager  not-applicable        info -
tool     runs                  pass -
tool     broken                fail on PATH but fails to run; broken install?
tool     missing               warn -
tool     optional              info -
shell    configured            pass -
shell    not-zsh               warn run: chsh -s $(which zsh)
shell    not-zsh-omarchy       warn point the terminal at zsh instead; Omarchy upstream discourages chsh
shell    unset                 warn -
shell    not-bootstrapped      warn bootstraps on the next zsh start
local    configured            pass -
local    optional              info -
local    unconfigured          warn -
local    incomplete            warn -
local    ineffective           warn -
local    hint                  info -
perms    expected              pass -
perms    unexpected            warn -
EOF
)"
readonly DOCTOR_STATES

# The sections, in order: classifier, vocabulary, title. `--only` selects by
# vocabulary.
DOCTOR_SECTIONS="$(
    cat << 'EOF'
classify_platform     platform System Information
classify_checkout     sync     Dotfiles Repository
classify_links        link     Symlink Status
classify_managers     manager  Package Managers
classify_core_tools   tool     Core Tools
classify_modern_tools tool     Modern CLI Tools
classify_shell        shell    Shell Configuration
classify_local        local    Local Configuration
classify_perms        perms    File Permissions
EOF
)"
readonly DOCTOR_SECTIONS

# --- the engine --------------------------------------------------------------

ISSUES=0
WARNINGS=0

emit() { printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}"; }

# Sets SEVERITY and NOTE for one (vocabulary, state). An unmapped state is
# a failure: a classifier that grew a state nobody mapped must be loud.
lookup_state() {
    local vocab state severity note
    while read -r vocab state severity note; do
        [[ "$vocab" == "$1" && "$state" == "$2" ]] || continue
        SEVERITY="$severity"
        NOTE="$note"
        [[ "$NOTE" == "-" ]] && NOTE=""
        return 0
    done <<< "$DOCTOR_STATES"
    SEVERITY=fail
    NOTE="doctor maps no severity to state '$2'"
}

# The one printer. Also the only thing that touches the tally.
report_row() {
    local severity="$1" msg="$2${3:+: $3}${4:+ ($4)}"
    case "$severity" in
        pass) print_success "$msg" ;;
        info) print_info "$msg" ;;
        warn)
            print_warn "$msg"
            ((++WARNINGS))
            ;;
        fail)
            print_error "$msg"
            ((++ISSUES))
            ;;
        skip) ;;
    esac
}

# run_section <classifier> <vocabulary> <title>
#
# The classifier runs to completion before anything prints, so a classifier
# that dies is reported as an issue instead of truncating the section
# silently. Rows it printed before dying are still reported.
run_section() {
    local classifier="$1" vocab="$2" rows state subject detail
    print_header "$3"
    if ! rows="$("$classifier")"; then
        report_row fail "$classifier" "classifier exited non-zero"
    fi
    while IFS=$'\t' read -r state subject detail; do
        [[ -n "$state" ]] || continue
        lookup_state "$vocab" "$state"
        report_row "$SEVERITY" "$subject" "${detail:-$state}" "$NOTE"
    done <<< "$rows"
}

# A path as a person would read it in a report.
tilde() {
    case "$1" in
        "$HOME"/*) printf '%s/%s\n' '~' "${1#"$HOME"/}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# --- classifiers -------------------------------------------------------------

classify_platform() {
    case "$PLATFORM_OS" in
        macos | arch | linux) emit supported os "$("$PLATFORM" describe)" ;;
        *) emit unsupported os "$("$PLATFORM" describe)" ;;
    esac
    emit fact arch "$("$PLATFORM" arch)"
    if "$PLATFORM" is-omarchy; then
        emit fact omarchy "detected (~/.local/share/omarchy) — see OPERATING.md § Omarchy"
    fi
    emit fact shell "$SHELL"
    emit fact user "${USER:-$(id -un)}"
    emit fact home "$HOME"
}

# Sync state, offline: compares against the last fetch rather than contacting
# the remote, so `doctor` stays fast and works on a plane. The state is the
# module's; only the wording of the detail is decided here.
classify_checkout() {
    git_sync_status "$DOTFILES_DIR" no-fetch
    local detail="${GIT_SYNC_DETAIL%%$'\n'*}"
    case "$GIT_SYNC_STATE" in
        "$GIT_SYNC_MISSING_DIR") detail="not found" ;;
        "$GIT_SYNC_NOT_A_REPO") detail="not a git repository (or not its root)" ;;
        "$GIT_SYNC_DIRTY")
            detail="$(printf '%s\n' "$GIT_SYNC_DETAIL" | wc -l | tr -d ' ') uncommitted change(s)"
            ;;
        "$GIT_SYNC_CLEAN_UPTODATE") detail="level with upstream as of last fetch" ;;
        "$GIT_SYNC_CLEAN_BEHIND")
            detail="behind upstream by $GIT_SYNC_BEHIND commit(s) as of last fetch"
            ;;
    esac
    emit "$GIT_SYNC_STATE" "$(tilde "$DOTFILES_DIR")" "$detail"
}

# Link state, from bin/link-state as-is; only the path is shortened.
classify_links() {
    local state path
    "$SCRIPT_DIR/link-state" | while IFS=$'\t' read -r state path; do
        emit "$state" "$(tilde "$path")"
    done
}

# On PATH is not the same as working. zathura sat installed-but-broken with a
# dyld error (`Library not loaded: libgirara.5.dylib`) and every existence
# check passed, because the binary was right there — it just could not start.
tool_runs() {
    command_exists "$1" || return 1
    "$1" --version > /dev/null 2>&1
}

# probe_tool <command> <state-when-absent> <detail-when-absent>
probe_tool() {
    if tool_runs "$1"; then
        emit runs "$1" installed
    elif command_exists "$1"; then
        emit broken "$1" "$(command -v "$1")"
    else
        emit "$2" "$1" "$3"
    fi
}

# Which managers are required is a platform question: Homebrew on macOS,
# pacman on Arch. Asked of bin/platform, so a pacman on PATH anywhere else —
# the repo's own sudo wrapper used to be one — is not reported.
classify_managers() {
    if tool_runs brew; then
        emit runs brew "$(brew --version 2> /dev/null | sed -n 1p)"
        # No auto-update: a bare `brew outdated` first refreshes every tap (>60s)
        local outdated
        outdated="$(HOMEBREW_NO_AUTO_UPDATE=1 brew outdated 2> /dev/null | wc -l | tr -d ' ')"
        if [[ "$outdated" -gt 0 ]]; then
            emit outdated brew "$outdated package(s) need updating"
        else
            emit current brew "all packages up to date"
        fi
    elif [[ "$PLATFORM_OS" == "macos" ]]; then
        probe_tool brew required-missing "Homebrew not installed"
    else
        probe_tool brew not-applicable "Homebrew not installed (macOS only)"
    fi

    if tool_runs npm; then
        emit runs npm "npm $(npm --version 2> /dev/null)"
    else
        probe_tool npm missing "not installed"
    fi

    if tool_runs cargo; then
        emit runs cargo "$(cargo --version 2> /dev/null)"
    else
        probe_tool cargo missing "not installed"
    fi

    if [[ "$PLATFORM_OS" == "arch" ]]; then
        probe_tool pacman required-missing "not installed"
    fi
}

classify_core_tools() {
    local tool
    for tool in "${DOCTOR_CORE_TOOLS[@]}"; do
        probe_tool "$tool" missing "not installed (core)"
    done
}

classify_modern_tools() {
    local tool
    for tool in "${DOCTOR_ESSENTIAL_TOOLS[@]}"; do
        probe_tool "$tool" missing "not installed (recommended)"
    done
    for tool in "${DOCTOR_NEXTGEN_TOOLS[@]}" "${DOCTOR_ADDITIONAL_TOOLS[@]}"; do
        probe_tool "$tool" optional "not installed (optional)"
    done
}

classify_shell() {
    # Prefer the passwd entry over $SHELL: a terminal launched with
    # `command = zsh` sets neither.
    local login_shell
    login_shell="$(getent passwd "${USER:-$(id -un)}" 2> /dev/null | cut -d: -f7 || true)"
    login_shell="${login_shell:-$SHELL}"
    if [[ "$login_shell" == *"zsh"* ]]; then
        emit configured login-shell "$login_shell"
    elif "$PLATFORM" is-omarchy; then
        # Omarchy ships bash as login shell and its boot chain (SDDM session,
        # ~/.bashrc, omarchy-* helpers) assumes it. Details in OPERATING.md.
        emit not-zsh-omarchy login-shell \
            "$login_shell; set 'command = $(command -v zsh || echo /usr/bin/zsh)' in ~/.config/ghostty/config"
    else
        emit not-zsh login-shell "$login_shell"
    fi

    if [[ -n "${ZDOTDIR:-}" ]]; then
        emit configured ZDOTDIR "$ZDOTDIR"
    else
        emit unset ZDOTDIR "not set"
    fi

    # Zinit is the plugin manager .zshrc uses; it self-installs on first run.
    if [[ -d "${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git" ]]; then
        emit configured zinit "installed"
    else
        emit not-bootstrapped zinit "not installed"
    fi
}

# Local config, from bin/dotfiles-init as-is: its rows are already in the
# engine's format. It is also what writes the files, so the health check and
# the fix cannot disagree about what "configured" means. Whether to suggest
# running it is its own verdict too (--check), not a judgement made here.
classify_local() {
    "$SCRIPT_DIR/dotfiles-init" --status || return
    if ! "$SCRIPT_DIR/dotfiles-init" --check > /dev/null 2>&1; then
        emit hint dotfiles-init "run 'make init' (or 'dotfiles-init') to fix what it can"
    fi
}

# expect_mode <path> <octal>
expect_mode() {
    local mode
    mode="$("$PLATFORM" file-mode "$1")"
    if [[ "$mode" == "$2" ]]; then
        emit expected "$(tilde "$1")" "$mode"
    else
        emit unexpected "$(tilde "$1")" "$mode (should be $2)"
    fi
}

classify_perms() {
    [[ -d "$HOME/.ssh" ]] || return 0
    expect_mode "$HOME/.ssh" 700
    local key
    while IFS= read -r key; do
        [[ -f "$key" ]] && expect_mode "$key" 600
    done < <(find "$HOME/.ssh" -name "id_*" -not -name "*.pub" 2> /dev/null | sort)
    return 0
}

# --- output ------------------------------------------------------------------

print_summary() {
    print_header "Summary"

    echo ""
    if [[ $ISSUES -eq 0 && $WARNINGS -eq 0 ]]; then
        echo -e "${GREEN}✓ All checks passed! System is healthy.${NC}"
    else
        [[ $ISSUES -gt 0 ]] && echo -e "${RED}✗ $ISSUES issue(s) found${NC}"
        [[ $WARNINGS -gt 0 ]] && echo -e "${YELLOW}⚠ $WARNINGS warning(s) found${NC}"
    fi
    echo ""
}

# Every probed command, one per line. Consumed by bin/validate-doctor-tools.
list_checked_tools() {
    printf '%s\n' \
        "${DOCTOR_CORE_TOOLS[@]}" \
        "${DOCTOR_ESSENTIAL_TOOLS[@]}" \
        "${DOCTOR_NEXTGEN_TOOLS[@]}" \
        "${DOCTOR_ADDITIONAL_TOOLS[@]}"
}

# The state table as `vocabulary<TAB>state<TAB>severity` rows, so tests can
# check it covers every state each classifier's own --states lists.
list_states() {
    local vocab state severity note
    while read -r vocab state severity note; do
        [[ -n "$vocab" ]] && printf '%s\t%s\t%s\n' "$vocab" "$state" "$severity"
    done <<< "$DOCTOR_STATES"
    return 0
}

show_help() {
    cat << EOF
Usage: dotfiles-doctor [OPTIONS]

Comprehensive health check for dotfiles system and configurations.

OPTIONS:
    -h, --help              Show this help message
    -v, --verbose           Trace execution (set -x)
    --only VOCABULARY       Run only the sections for one vocabulary:
                            platform sync link manager tool shell local perms
    --states                Print the state table: vocabulary, state, severity
    --list-checked-tools    List the commands this check probes

DESCRIPTION:
    Checks system health including:
    - System information and platform
    - Dotfiles repository sync state
    - Link state of every managed path
    - Package manager status
    - Core and modern CLI tool availability
    - Shell configuration
    - Local configuration (git/jj identity, SSH host snippets)
    - File permissions

EXIT CODES:
    0    No issues (warnings alone do not fail)
    1    Issues found, or bad usage

EXAMPLES:
    dotfiles-doctor              Run health check
    dotfiles-doctor --only sync  Check just the checkout against its upstream

EOF
}

main() {
    local only=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h | --help)
                show_help
                exit 0
                ;;
            -v | --verbose)
                set -x
                shift
                ;;
            --only)
                only="${2:-}"
                if ! list_states | cut -f1 | grep -qxF -- "$only"; then
                    echo "Unknown vocabulary for --only: '$only'" >&2
                    exit 1
                fi
                shift 2
                ;;
            --states)
                list_states
                exit 0
                ;;
            --list-checked-tools)
                list_checked_tools
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done

    echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║                  Dotfiles Health Check                        ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"

    # fd 3, not stdin: a classifier that reads stdin would eat the list.
    local classifier vocab title
    while read -r classifier vocab title <&3; do
        [[ -z "$only" || "$only" == "$vocab" ]] || continue
        run_section "$classifier" "$vocab" "$title"
    done 3<<< "$DOCTOR_SECTIONS"

    print_summary
    [[ $ISSUES -eq 0 ]]
}

main "$@"
