#!/usr/bin/env bash
# firefox-user-js - Install this checkout's user.js into Firefox's real profiles.
#
# `.config/firefox/user.js` is stowed to `~/.config/firefox/user.js`, which
# Firefox never reads: `user.js` is per-profile, read from inside the profile
# directory at startup. 81KB of arkenfox hardening sat at the stow target
# taking effect on nothing. This module puts it where Firefox actually looks.
#
# Usage:
#   firefox-user-js profiles [options]   # role<TAB>path, one row per profile
#   firefox-user-js status   [options]   # state<TAB>path, one row per profile
#   firefox-user-js install  [options]   # place user.js in the default profile
#   firefox-user-js --states             # the state vocabulary, one per line
#
# Options:
#   --all        every profile in profiles.ini, not just the default one
#   --copy       copy instead of symlinking (see "Symlink, not copy")
#   --dry-run    report what install would do; change nothing
#   --root DIR   the Firefox root to operate on (default: per platform)
#
# States:
#   linked     user.js is a symlink resolving to this checkout's copy
#   installed  user.js is a regular file identical to this checkout's copy
#   foreign    a user.js is present that this checkout did not put there
#   absent     the profile exists and has no user.js
#   missing    profiles.ini names the profile, but the directory is not there
#
# Roles: `default` is the profile Firefox actually opens; `other` is every
# other one. The distinction matters more than it looks — see below.
#
# --- Discovery: profiles.ini, never a glob ---------------------------------
#
# Profiles are read from `profiles.ini`, not from globbing `Profiles/*/`. A
# glob picks up profiles Firefox has abandoned, and it cannot tell which one
# is live. On the machine this was written for, globbing found two profiles
# and profiles.ini disagreed with the obvious reading of both:
#
#   [Profile0] Path=Profiles/tdd8eekl.default-release   <- 124MB, the live one
#   [Install…] Default=Profiles/tdd8eekl.default-release
#   [Profile1] Path=Profiles/zkl7w8l2.default  Default=1 <- 4KB, never opened
#
# `Default=1` in a [Profile N] section is the legacy fallback default;
# `Default=` in an [Install…] section names the profile that *this install*
# of Firefox actually opens, and it wins. Reading only `Default=1` would have
# hardened the dead 4KB profile and left the live one untouched — the same
# silent no-op this module exists to fix. [Install…] may appear before or
# after the profile it names (here it sits between Profile0 and Profile1), so
# the rows are buffered and the role decided in a second pass.
#
# --- Symlink, not copy -----------------------------------------------------
#
# Default is a symlink into the checkout, so editing `.config/firefox/user.js`
# reaches Firefox at its next start with no reinstall step. The worry that
# Firefox refuses to follow a symlinked user.js was tested rather than
# assumed: on Firefox 155.0.1 / macOS 15, two throwaway profiles were booted
# headless, one with a symlinked user.js and one with a copy, and both wrote
# the same prefs into `prefs.js`. Symlink works.
#
# `--copy` stays for the case that is genuinely different: a sandboxed
# Firefox (Flatpak, Snap) can only see paths its sandbox exports, so a
# symlink pointing into an arbitrary checkout resolves to nothing there.
#
# --- Never clobber ---------------------------------------------------------
#
# A `foreign` user.js is moved aside to `user.js.bak.<timestamp>` before being
# replaced. Idempotent: a profile already in the desired state is left alone
# entirely, so a second run neither rewrites the file nor takes a second
# backup. Switching between symlink and copy mode replaces our own file
# without a backup — there is nothing of the user's to lose.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"
# shellcheck source=lib/ui.sh
source "$SCRIPT_DIR/lib/ui.sh"

# Resolved from SCRIPT_DIR, not DOTFILES_DIR: DOTFILES_DIR is the checkout
# being operated on and tests point it at a fixture, which does not ship bin/.
readonly PLATFORM="$SCRIPT_DIR/platform"

readonly SOURCE="$DOTFILES_DIR/.config/firefox/user.js"

# The vocabulary, so callers and tests do not re-type it.
readonly USER_JS_STATES="linked installed foreign absent missing"

# --- where Firefox keeps its profiles --------------------------------------

# The one OS branch in this module, and it goes through bin/platform rather
# than testing $OSTYPE inline (CONTEXT.md § Platform).
default_root() {
    if "$PLATFORM" is-macos; then
        printf '%s\n' "$HOME/Library/Application Support/Firefox"
    else
        printf '%s\n' "$HOME/.mozilla/firefox"
    fi
}

# --- profiles.ini ----------------------------------------------------------

# Absolute path for a profiles.ini Path= value. IsRelative=0 means the value
# is already absolute; anything starting with / is treated that way too,
# because a profiles.ini written by hand often omits IsRelative.
absolutise() {
    local root="$1" path="$2" isrel="$3"
    if [[ "$isrel" == "0" || "$path" == /* ]]; then
        printf '%s\n' "$path"
    else
        printf '%s\n' "$root/$path"
    fi
}

# Emit `role<TAB>abs_path`, one row per [Profile N] section, in file order.
read_profiles() {
    local root="$1" ini="$1/profiles.ini"
    if [[ ! -f "$ini" ]]; then
        print_error "No profiles.ini at $ini" >&2
        return 1
    fi

    local section="" key value
    local path="" isrel="1" isdefault="0"
    local records="" install_path="" install_rel="1"

    # Buffer one record per profile. No `declare -A` and no `mapfile`: macOS
    # ships bash 3.2 and has neither.
    flush() {
        [[ -n "$path" ]] || return 0
        records="$records$(printf '%s\t%s' "$isdefault" "$(absolutise "$root" "$path" "$isrel")")"$'\n'
        path=""
        isrel="1"
        isdefault="0"
    }

    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}" # profiles.ini is CRLF on some installs
        case "$line" in
            \[*\])
                flush
                section="${line#[}"
                section="${section%]}"
                continue
                ;;
        esac
        [[ "$line" == *=* ]] || continue
        key="${line%%=*}"
        value="${line#*=}"

        case "$section" in
            Profile*)
                case "$key" in
                    Path) path="$value" ;;
                    IsRelative) isrel="$value" ;;
                    Default) isdefault="$value" ;;
                esac
                ;;
            Install*)
                # First [Install…] wins; a machine with two Firefox installs
                # has two, and there is no basis here for preferring the
                # second over the first.
                case "$key" in
                    Default) [[ -n "$install_path" ]] || install_path="$value" ;;
                    IsRelative) install_rel="$value" ;;
                esac
                ;;
        esac
    done < "$ini"
    flush

    local install_abs=""
    [[ -n "$install_path" ]] && install_abs="$(absolutise "$root" "$install_path" "$install_rel")"

    local isdef abs role
    while IFS=$'\t' read -r isdef abs; do
        [[ -n "$abs" ]] || continue
        if [[ -n "$install_abs" ]]; then
            # An [Install…] Default= is authoritative; Default=1 is not.
            if [[ "$abs" == "$install_abs" ]]; then role="default"; else role="other"; fi
        elif [[ "$isdef" == "1" ]]; then
            role="default"
        else
            role="other"
        fi
        printf '%s\t%s\n' "$role" "$abs"
    done <<< "$records"
    return 0
}

# --- state -----------------------------------------------------------------

# readlink -f canonicalises (/var -> /private/var on macOS, and any symlinked
# parent anywhere), so the expected side is canonicalised too. Comparing a
# canonical path against a raw one reports a correct link as foreign.
canonical() {
    readlink -f "$1" 2> /dev/null || printf '%s' "$1"
}

state_of() {
    local dir="$1" target="$1/user.js" resolved
    [[ -d "$dir" ]] || {
        printf 'missing\n'
        return 0
    }
    if [[ -L "$target" ]]; then
        resolved="$(canonical "$target")"
        if [[ -e "$target" && "$resolved" == "$(canonical "$SOURCE")" ]]; then
            printf 'linked\n'
        else
            printf 'foreign\n'
        fi
        return 0
    fi
    if [[ -f "$target" ]]; then
        if cmp -s "$target" "$SOURCE"; then
            printf 'installed\n'
        else
            printf 'foreign\n'
        fi
        return 0
    fi
    if [[ -e "$target" ]]; then
        printf 'foreign\n'
        return 0
    fi
    printf 'absent\n'
    return 0
}

# --- is Firefox holding the prefs it is about to be handed? -----------------

# user.js is read once, at startup. Writing it under a running Firefox is not
# harmful, but it is a no-op until the browser restarts — and silently doing
# nothing is exactly the failure this module exists to end, so it is said out
# loud. Deliberately not `pgrep … | grep`: a grep that exits on the first
# match SIGPIPEs the producer, and pipefail then reports the pipeline failed.
firefox_running() {
    command_exists pgrep || return 1
    local name
    for name in firefox firefox-bin firefox-esr; do
        if pgrep -x "$name" > /dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

# --- install ---------------------------------------------------------------

place() {
    local target="$1"
    if [[ -n "$COPY" ]]; then
        cp "$SOURCE" "$target"
    else
        ln -s "$SOURCE" "$target"
    fi
}

install_into() {
    local dir="$1" target="$1/user.js" state want backup
    want="$([[ -n "$COPY" ]] && printf 'installed' || printf 'linked')"
    state="$(state_of "$dir")"

    if [[ "$state" == "missing" ]]; then
        print_warn "Skipping $dir (profiles.ini names it, but it is not there)"
        return 0
    fi

    if [[ "$state" == "$want" ]]; then
        print_info "Already current: $target"
        return 0
    fi

    if [[ "$state" == "foreign" ]]; then
        backup="$target.bak.$(date +%Y%m%d_%H%M%S)"
        if [[ -n "$DRY_RUN" ]]; then
            print_info "Would back up $target -> $backup"
        else
            mv "$target" "$backup"
            print_warn "Backed up existing user.js -> $backup"
        fi
    fi

    if [[ -n "$DRY_RUN" ]]; then
        print_info "Would $([[ -n "$COPY" ]] && printf 'copy' || printf 'link') $SOURCE -> $target"
        return 0
    fi

    # `absent`, or ours in the other mode: replacing our own file needs no
    # backup, and rm makes `ln -s` idempotent without -f hiding a surprise.
    rm -f "$target"
    place "$target"
    print_success "$target"
    return 0
}

do_install() {
    local root="$1" role abs targeted=0
    if [[ ! -f "$SOURCE" ]]; then
        print_error "No user.js in this checkout at $SOURCE"
        return 1
    fi

    if firefox_running; then
        print_warn "Firefox is running; user.js is read at startup, so this takes effect after a restart"
    fi

    local rows
    rows="$(read_profiles "$root")" || return 1

    while IFS=$'\t' read -r role abs; do
        [[ -n "$abs" ]] || continue
        if [[ -z "$ALL" && "$role" != "default" ]]; then
            continue
        fi
        targeted=$((targeted + 1))
        install_into "$abs"
    done <<< "$rows"

    if [[ "$targeted" -eq 0 ]]; then
        print_error "No profile selected (no default profile in profiles.ini; try --all)"
        return 1
    fi
    return 0
}

# --- main ------------------------------------------------------------------

ALL=""
COPY=""
DRY_RUN=""
ROOT=""

main() {
    local cmd=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) ALL=1 ;;
            --copy) COPY=1 ;;
            --dry-run) DRY_RUN=1 ;;
            --root)
                shift
                ROOT="${1:-}"
                [[ -n "$ROOT" ]] || {
                    print_error "--root needs a directory"
                    return 2
                }
                ;;
            --states)
                local st
                for st in $USER_JS_STATES; do printf '%s\n' "$st"; done
                return 0
                ;;
            -h | --help)
                sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'
                return 0
                ;;
            -*)
                print_error "Unknown option '$1'"
                return 2
                ;;
            *)
                [[ -z "$cmd" ]] || {
                    print_error "Unexpected argument '$1'"
                    return 2
                }
                cmd="$1"
                ;;
        esac
        shift
    done

    [[ -n "$ROOT" ]] || ROOT="$(default_root)"

    case "${cmd:-}" in
        profiles) read_profiles "$ROOT" ;;
        status)
            local rows role abs
            # Captured rather than piped from a process substitution: a
            # failing read_profiles inside `< <(...)` leaves the loop with
            # nothing to read and the command exiting 0, which would report
            # a missing profiles.ini as "no profiles".
            rows="$(read_profiles "$ROOT")" || return 1
            while IFS=$'\t' read -r role abs; do
                [[ -n "$abs" ]] || continue
                printf '%s\t%s\n' "$(state_of "$abs")" "$abs"
            done <<< "$rows"
            ;;
        install) do_install "$ROOT" ;;
        "")
            sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'
            return 2
            ;;
        *)
            print_error "Unknown command '$cmd' (one of: profiles status install)"
            return 2
            ;;
    esac
}

main "$@"
