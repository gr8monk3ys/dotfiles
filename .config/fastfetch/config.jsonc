// fastfetch - the screenshot.
//
// The logo is the painting itself, not ASCII approximating it: Ghostty speaks
// the Kitty graphics protocol, so `kitty-direct` hands it the file and lets the
// terminal draw it. `bin/wallpaper logo` produces that crop from the same
// cached scan the desktop background comes from. If it is missing — a fresh
// machine where `wallpaper` has not run yet — fastfetch falls back to the
// built-in ASCII logo silently, which is the right behaviour.
//
// Colours are deliberately *named*, not hex. Named colours resolve through the
// terminal's own palette, and Ghostty's palette is .config/palette/danse.conf,
// so fastfetch inherits the retune instead of carrying a copy that can drift.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "~/.local/share/wallpapers/danse-logo.png",
    "width": 32,
    "height": 16,
    "padding": {
      "top": 2,
      "right": 4
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    },
    "key": {
      "width": 11
    }
  },

  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "packages" },
    { "type": "shell", "key": "shell" },
    "break",
    { "type": "wm", "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "terminalfont", "key": "font" },
    { "type": "editor", "key": "editor" },
    "break",
    { "type": "cpu", "key": "cpu" },
    { "type": "gpu", "key": "gpu" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "battery", "key": "battery" },
    "break",
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
