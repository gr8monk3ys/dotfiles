// Field Notebook dashboard plate 01 ("Instrument"). Only the login dashboard
// uses this file; plain `fastfetch` keeps its normal config.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.local/share/field-notebook/signature-pen.png",
    "width": 38,
    "height": 4,
    "position": "top",
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "green", "title": "green" },
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[90mI N S T R U M E N T   ·   P L A T E   0 1\u001b[0m" },
    "break",
    { "type": "os",       "key": "  os",      "format": "{pretty-name}" },
    { "type": "kernel",   "key": "  kernel" },
    { "type": "wm",       "key": "  wm" },
    { "type": "command",  "key": "  theme",   "text": "omarchy theme current" },
    { "type": "command",  "key": "  font",    "text": "omarchy font current" },
    { "type": "command",  "key": "  term",    "text": "ghostty --version | head -1" },
    { "type": "uptime",   "key": "  uptime" },
    { "type": "packages", "key": "  pkgs" },
    "break",
    { "type": "cpu",      "key": "  cpu",     "format": "{name}  ·  {cores-logical} threads" },
    { "type": "gpu",      "key": "  gpu",     "format": "{name}" },
    { "type": "memory",   "key": "  mem" },
    { "type": "disk",     "key": "  disk",    "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
