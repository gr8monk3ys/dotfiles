#!/bin/bash
# JankyBorders - draws the focused-window border macOS does not.
#
# Under a tiling window manager the border is how you know where focus is:
# AeroSpace moves focus without moving the mouse, and macOS gives an unfocused
# window almost no visual distinction. This is the single clearest signal in
# the setup, so the active colour is the palette's primary accent.
#
# Launched from aerospace.toml's after-startup-command, not as a brew service,
# so window-manager chrome starts and stops with the window manager.
#
# Colours are 0xAARRGGBB. The default is Monochrome 43
# (.config/palette/monochrome-43.conf: fg, inactive): a 1px white hairline on
# the focused window and #333333 on the rest, as on Omarchy's Hyprland.

options=(
    style=round
    width=1.0
    hidpi=on
    active_color=0xffffffff   # fg - focused
    inactive_color=0xff333333 # inactive - everything else
    background_color=0x00000000
)

# The older danse look, with `danse` in palette/rice.local (same switch as
# sketchybar/colors.sh): a 5px blue border, from .config/palette/danse.conf
# (blue, surface).
rice=""
rice_file="${XDG_CONFIG_HOME:-$HOME/.config}/palette/rice.local"
[ -r "$rice_file" ] && read -r rice < "$rice_file"
if [ "$rice" = danse ]; then
    options=(
        style=round
        width=5.0
        hidpi=on
        active_color=0xff61afef   # blue - focused
        inactive_color=0xff3e4451 # surface - everything else
        background_color=0x00000000
    )
fi

borders "${options[@]}"
