# Generated by bin/rice-themes from .config/palette/templates/zathurarc
# for the danse rice. Edit the template, then `bin/rice-themes render`.
# The `zathura` shell function in .config/zsh/rice.zsh opens zathura with
# `-c` on this directory; ../../zathurarc (a link to one of these) is what a
# zathura started outside the shell reads.
# See `man zathurarc'

# One page per row by default
set pages-per-row 1

#stop at page boundries
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 0.01

# maps
map r reload
map p print
map i recolor
map J zoom out
map K zoom in
map R rotate


#zoom settings
set zoom-min 10
set guioptions ""

set font "inconsolata 15"

# Colours: the danse palette's ground, text and status colours.
set default-bg "#21252b"
set default-fg "#abb2bf"

set statusbar-fg "#abb2bf"
set statusbar-bg "#3e4451"

set inputbar-bg "#282c34"
set inputbar-fg "#abb2bf"

set notification-error-bg "#e06a51"
set notification-error-fg "#21252b"

set notification-warning-bg "#e5c07b"
set notification-warning-fg "#21252b"

set highlight-color "#e5c07b"
set highlight-active-color "#61afef"

set completion-highlight-fg "#21252b"
set completion-highlight-bg "#61afef"

set completion-bg "#282c34"
set completion-fg "#abb2bf"

set notification-bg "#98c379"
set notification-fg "#21252b"

# Pages are drawn in the palette's ground and text colours.
set recolor "true"
set recolor-lightcolor "#21252b"
set recolor-darkcolor "#abb2bf"
set recolor-reverse-video "true"
set recolor-keephue "true"

set selection-clipboard clipboard
set render-loading "false"
