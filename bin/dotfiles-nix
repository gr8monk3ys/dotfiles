#!/usr/bin/env bash
# dotfiles-nix - Manage Nix configuration for dotfiles.

set -euo pipefail

# Default to the checkout this script lives in (works through symlinks), so
# running bin/dotfiles-* from any clone operates on that clone.
readonly DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly YELLOW='\033[1;33m'
readonly RED='\033[0;31m'
readonly NC='\033[0m'

usage() {
    cat << 'EOF'
Usage: dotfiles-nix <command>

Commands:
  install   Install Nix package manager (Determinate Systems installer)
  darwin    Apply nix-darwin configuration (macOS full system)
  home      Apply Home Manager configuration (user environment only)
  update    Update Nix flake inputs
  check     Check Nix flake for errors
  gc        Garbage collect Nix store
  shell     Enter Nix development shell
  help      Show this help

Examples:
  dotfiles-nix install
  dotfiles-nix darwin
  dotfiles-nix home
  dotfiles-nix update
EOF
}

die() {
    echo -e "${RED}Error:${NC} $*" >&2
    exit 1
}

info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

cmd_install() {
    if command -v nix >/dev/null 2>&1; then
        success "Nix already installed"
    else
        info "Installing Nix..."
        curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install
        echo ""
        info "Please restart your shell and run 'dotfiles-nix darwin' or 'dotfiles-nix home'"
    fi
}

cmd_darwin() {
    info "Applying nix-darwin configuration..."
    if command -v darwin-rebuild >/dev/null 2>&1; then
        darwin-rebuild switch --flake "$DOTFILES_DIR"
    else
        info "First-time setup: bootstrapping nix-darwin..."
        nix run nix-darwin -- switch --flake "$DOTFILES_DIR"
    fi
    success "nix-darwin configuration applied"
}

cmd_home() {
    info "Applying Home Manager configuration..."
    if command -v home-manager >/dev/null 2>&1; then
        home-manager switch --flake "$DOTFILES_DIR"
    else
        info "First-time setup: bootstrapping Home Manager..."
        nix run home-manager -- switch --flake "$DOTFILES_DIR"
    fi
    success "Home Manager configuration applied"
}

cmd_update() {
    info "Updating Nix flake inputs..."
    nix flake update "$DOTFILES_DIR"
    success "Flake inputs updated"
    info "Run 'dotfiles-nix darwin' or 'dotfiles-nix home' to apply updates"
}

cmd_check() {
    info "Checking Nix flake..."
    nix flake check "$DOTFILES_DIR"
}

cmd_gc() {
    info "Cleaning up Nix store..."
    nix-collect-garbage -d
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sudo nix-collect-garbage -d
    fi
    success "Nix garbage collection complete"
}

cmd_shell() {
    nix develop "$DOTFILES_DIR"
}

# Dispatch
case "${1:-help}" in
    install) cmd_install ;;
    darwin)  cmd_darwin ;;
    home)    cmd_home ;;
    update)  cmd_update ;;
    check)   cmd_check ;;
    gc)      cmd_gc ;;
    shell)   cmd_shell ;;
    help|-h|--help) usage ;;
    *)
        die "Unknown command: $1. Run '$0 help' for usage."
        ;;
esac
