# Example host snippet. Copy to pi-lab.conf (gitignored) and fill in real values;
# every *.conf in this directory is Included by ~/.ssh/config after `make link`.
Host pi
  HostName 192.0.2.10
  User <your-user>
  Port 2222
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host pi-gw
  HostName 192.0.2.10
  User <your-user>
  Port 2222
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ExitOnForwardFailure yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  LocalForward 13011 127.0.0.1:3011
  LocalForward 12586 127.0.0.1:2586
