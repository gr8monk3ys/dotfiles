# EditorConfig helps maintain consistent coding styles across editors and IDEs
# See https://editorconfig.org for more information

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell scripts
[*.{sh,bash,zsh}]
indent_size = 4

# Makefile - must use tabs
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# Python
[*.py]
indent_size = 4
max_line_length = 88

# Go
[*.go]
indent_style = tab
indent_size = 4

# Rust
[*.rs]
indent_size = 4
max_line_length = 100

# C/C++
[*.{c,cpp,h,hpp}]
indent_size = 4

# Java
[*.java]
indent_size = 4

# JavaScript/TypeScript
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# TOML
[*.toml]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

# HTML/CSS/SCSS
[*.{html,css,scss,sass,less}]
indent_size = 2

# XML
[*.xml]
indent_size = 2

# Ruby
[*.rb]
indent_size = 2

# PHP
[*.php]
indent_size = 4

# Lua
[*.lua]
indent_size = 2

# Vim script
[*.vim]
indent_size = 2

# Configuration files
[*.{conf,config,ini}]
indent_size = 4

# Git commit messages
[COMMIT_EDITMSG]
max_line_length = 72

# Package files
[{package.json,composer.json}]
indent_size = 2
