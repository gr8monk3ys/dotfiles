#!/usr/bin/env bash
# dotfiles-update - Update all packages and configurations

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"
# shellcheck source=lib/ui.sh
source "$SCRIPT_DIR/lib/ui.sh"
# shellcheck source=lib/git-sync.sh
source "$SCRIPT_DIR/lib/git-sync.sh"

# Set when the repository step was skipped for a benign reason, so the
# summary can say so instead of claiming an unqualified success.
REPO_SKIPPED=""
# Kinds whose update failed. Only possible under STRICT_PACKAGES; otherwise
# install-kind reports the failure itself and carries on.
FAILED_KINDS=""

# Update dotfiles repository
update_dotfiles() {
    print_header "Updating Dotfiles Repository"

    git_sync_apply "$DOTFILES_DIR"

    case "$GIT_SYNC_STATE" in
        "$GIT_SYNC_PULLED")
            print_success "Updated successfully ($GIT_SYNC_BEHIND commit(s))"
            ;;
        "$GIT_SYNC_CLEAN_UPTODATE")
            print_success "Already up to date"
            ;;
        "$GIT_SYNC_DIRTY")
            # Uncommitted work in the checkout is no reason to skip the
            # package updates that follow.
            print_warn "Uncommitted changes detected - skipping repository update"
            echo "$GIT_SYNC_DETAIL"
            REPO_SKIPPED="uncommitted changes"
            ;;
        "$GIT_SYNC_NO_UPSTREAM")
            print_warn "No upstream configured - skipping repository update"
            REPO_SKIPPED="no upstream configured"
            ;;
        "$GIT_SYNC_DIVERGED")
            print_error "Local and remote have diverged. Manual merge required."
            return 1
            ;;
        "$GIT_SYNC_FETCH_FAILED")
            print_error "Failed to fetch updates"
            echo "$GIT_SYNC_DETAIL"
            return 1
            ;;
        "$GIT_SYNC_PULL_FAILED")
            print_error "Failed to pull changes"
            echo "$GIT_SYNC_DETAIL"
            return 1
            ;;
        *)
            print_error "$GIT_SYNC_DETAIL"
            return 1
            ;;
    esac
}

# Update every manifest kind through the kind module, which owns how each
# package manager upgrades; this script owns only the order and the report.
# A kind that fails is recorded and the rest still run, so one broken tool
# does not leave the others stale. A for loop, not `while read`: the kind's
# tools must inherit this script's stdin, not the list of kinds.
update_packages() {
    local kind
    for kind in $("$SCRIPT_DIR/manifest" kinds); do
        print_header "Updating $kind"
        if ! "$SCRIPT_DIR/install-kind" update "$kind"; then
            print_error "Updating $kind failed"
            FAILED_KINDS="$FAILED_KINDS $kind"
        fi
    done
}

# Update Zinit and its plugins
update_zinit() {
    print_header "Updating Zinit"

    local zinit_home="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"

    if [[ ! -d "$zinit_home" ]]; then
        print_info "Zinit not installed, skipping..."
        return 0
    fi

    print_info "Updating Zinit and plugins..."
    # Source zinit.zsh directly in a non-interactive zsh: zinit update
    # works from the on-disk plugin store, and skipping .zshrc avoids
    # loading the full interactive setup (starship, atuin).
    # shellcheck disable=SC2016  # $ZINIT_HOME is expanded by the child zsh
    if env ZINIT_HOME="$zinit_home" zsh -c \
        'source "$ZINIT_HOME/zinit.zsh" && zinit self-update && zinit update --all'; then
        print_success "Zinit and plugins updated"
    else
        print_error "Zinit update failed"
    fi
}

# Update Neovim plugins
update_nvim() {
    print_header "Updating Neovim Plugins"

    if ! command_exists nvim; then
        print_info "Neovim not installed, skipping..."
        return 0
    fi

    print_info "Updating Neovim plugins..."
    # This depends on your plugin manager
    # For lazy.nvim:
    if nvim --headless "+Lazy! sync" +qa 2>/dev/null; then
        print_success "Neovim plugins updated"
    else
        print_info "Plugin update command may have failed (check manually)"
    fi
}

# Generate update report
generate_report() {
    print_header "Update Summary"

    echo ""
    if [[ -n "$FAILED_KINDS" ]]; then
        print_error "Update finished with failures:$FAILED_KINDS"
    elif [[ -n "$REPO_SKIPPED" ]]; then
        print_warn "Update complete - repository not updated ($REPO_SKIPPED)"
    else
        print_success "Update complete!"
    fi
    echo ""
    print_info "Run 'dotfiles-doctor' to check system health"
    echo ""
}

# Show help message
show_help() {
    cat << EOF
Usage: dotfiles-update [OPTIONS]

Update all packages, configurations, and tools in the dotfiles system.

OPTIONS:
    -h, --help       Show this help message
    -v, --verbose    Show verbose output during updates
    --skip <kind>    Skip one manifest kind; repeatable. Kinds:
                     $(printf '%s' "$1" | tr '\n' ' ')

DESCRIPTION:
    Updates the following:
    - Dotfiles repository (git pull, fast-forward only)
    - Every manifest kind, via 'install-kind update <kind>': Homebrew
      formulae and casks, npm and cargo globals, pacman, editor extensions
    - Zinit and its zsh plugins
    - Neovim plugins

    Uncommitted changes in the checkout skip the repository step only;
    the package updates still run.

ENVIRONMENT:
    SKIP_KINDS        Kinds to skip, as for make (--skip adds to it)
    STRICT_PACKAGES   1/true: a failed kind makes the run exit non-zero

REQUIREMENTS:
    - Internet connection

EXAMPLES:
    dotfiles-update                          Update everything
    dotfiles-update --skip brew --skip cask  Leave Homebrew alone
    dotfiles-update --skip pacman            Leave the system to omarchy-update

EOF
}

# Main
main() {
    local kinds
    kinds="$("$SCRIPT_DIR/manifest" kinds)"
    SKIP_KINDS="${SKIP_KINDS:-}"

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help "$kinds"
                exit 0
                ;;
            -v|--verbose)
                set -x
                shift
                ;;
            --skip)
                # Validated here: a misspelt kind in SKIP_KINDS matches
                # nothing, so it would silently skip nothing.
                if [[ -z "${2:-}" ]] || ! printf '%s\n' "$kinds" | grep -Fxq -- "$2"; then
                    echo "--skip needs a kind, one of: $(printf '%s' "$kinds" | tr '\n' ' ')"
                    exit 1
                fi
                SKIP_KINDS="$SKIP_KINDS $2"
                shift 2
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done
    export SKIP_KINDS

    echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║                    Dotfiles Updater                           ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"

    # Update dotfiles repository first
    update_dotfiles || {
        print_error "Failed to update dotfiles repository"
        exit 1
    }

    update_packages

    # Update shell and editor
    update_zinit
    update_nvim

    # Generate report
    generate_report

    [[ -z "$FAILED_KINDS" ]]
}

main "$@"
