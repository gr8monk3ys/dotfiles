# Generated by bin/rice-themes from .config/palette/templates/delta.gitconfig
# for the field-notebook rice. Edit the template, then `bin/rice-themes render`.
#
# A delta feature, included from .config/git/config. .config/zsh/rice.zsh
# sets DELTA_FEATURES=rice-<rice>, which picks one of these per shell.
[delta "rice-field-notebook"]
	syntax-theme = field-notebook
	plus-style = "syntax #1c342c"
	plus-emph-style = "syntax #42a979"
	minus-style = "syntax #3b2a2d"
	minus-emph-style = "syntax #e87c7c"
	line-numbers-minus-style = "#e87c7c"
	line-numbers-plus-style = "#42a979"
	line-numbers-zero-style = "#767c87"
	hunk-header-decoration-style = "#7aa0e6 box"
	file-style = "bold #7aa0e6"
