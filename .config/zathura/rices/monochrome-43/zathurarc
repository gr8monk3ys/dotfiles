# Generated by bin/rice-themes from .config/palette/templates/zathurarc
# for the monochrome-43 rice. Edit the template, then `bin/rice-themes render`.
# The `zathura` shell function in .config/zsh/rice.zsh opens zathura with
# `-c` on this directory; ../../zathurarc (a link to one of these) is what a
# zathura started outside the shell reads.
# See `man zathurarc'

# One page per row by default
set pages-per-row 1

#stop at page boundries
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 0.01

# maps
map r reload
map p print
map i recolor
map J zoom out
map K zoom in
map R rotate


#zoom settings
set zoom-min 10
set guioptions ""

set font "inconsolata 15"

# Colours: the monochrome-43 palette's ground, text and status colours.
set default-bg "#000000"
set default-fg "#e6eaf2"

set statusbar-fg "#e6eaf2"
set statusbar-bg "#2a2a2a"

set inputbar-bg "#000000"
set inputbar-fg "#e6eaf2"

set notification-error-bg "#ff003c"
set notification-error-fg "#000000"

set notification-warning-bg "#f7768e"
set notification-warning-fg "#000000"

set highlight-color "#f7768e"
set highlight-active-color "#7aa2f7"

set completion-highlight-fg "#000000"
set completion-highlight-bg "#7aa2f7"

set completion-bg "#000000"
set completion-fg "#e6eaf2"

set notification-bg "#c2c2c2"
set notification-fg "#000000"

# Pages are drawn in the palette's ground and text colours.
set recolor "true"
set recolor-lightcolor "#000000"
set recolor-darkcolor "#e6eaf2"
set recolor-reverse-video "true"
set recolor-keephue "true"

set selection-clipboard clipboard
set render-loading "false"
