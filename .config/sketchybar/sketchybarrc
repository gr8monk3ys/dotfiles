#!/bin/bash

# SketchyBar Configuration
# https://felixkratz.github.io/SketchyBar/
# Floating macOS status bar with AeroSpace workspace indicators

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

# ============================================================================
# Bar Appearance
# ============================================================================
if [ "$RICE" = monochrome-43 ]; then
    # Monochrome 43 (opt-in, see colors.sh): a slim, flat, pure-black strip
    # flush with the top edge, white text in the Nerd Font Ghostty uses.
    FONT="JetBrainsMono Nerd Font"
    APPLE_ICON_FONT="$FONT:Bold:15.0"
    sketchybar --bar \
        height=28 \
        color=$BAR_COLOR \
        border_width=0 \
        shadow=off \
        position=top \
        sticky=on \
        padding_right=8 \
        padding_left=8 \
        corner_radius=0 \
        y_offset=0 \
        margin=0 \
        blur_radius=0 \
        notch_width=188
    sketchybar --default \
        icon.font="$FONT:Bold:13.0" \
        icon.color=$FOREGROUND \
        label.font="$FONT:Medium:12.0" \
        label.color=$FOREGROUND \
        background.color=$BACKGROUND \
        background.corner_radius=0 \
        background.height=20 \
        padding_left=4 \
        padding_right=4 \
        label.padding_left=4 \
        label.padding_right=8 \
        icon.padding_left=8 \
        icon.padding_right=4
else
    APPLE_ICON_FONT="SF Pro:Black:16.0"
    sketchybar --bar \
        height=37 \
        color=$BAR_COLOR \
        border_color=$BAR_BORDER_COLOR \
        border_width=2 \
        shadow=on \
        position=top \
        sticky=on \
        padding_right=10 \
        padding_left=10 \
        corner_radius=9 \
        y_offset=10 \
        margin=10 \
        blur_radius=20 \
        notch_width=188

    sketchybar --default \
        icon.font="SF Pro:Semibold:14.0" \
        icon.color=$FOREGROUND \
        label.font="SF Pro:Medium:13.0" \
        label.color=$FOREGROUND \
        background.color=$BACKGROUND \
        background.corner_radius=5 \
        background.height=24 \
        padding_left=5 \
        padding_right=5 \
        label.padding_left=4 \
        label.padding_right=10 \
        icon.padding_left=10 \
        icon.padding_right=4
fi

# ============================================================================
# Load Items
# ============================================================================

# Left side
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"

# Right side, outermost first: calendar sits at the far right.
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/cpu.sh"

# ============================================================================
# Finalize
# ============================================================================
sketchybar --update
