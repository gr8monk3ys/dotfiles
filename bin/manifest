#!/usr/bin/env bash
# manifest - The single reader of install/ package manifests.
#
# Every consumer that needs to know "what packages does this system install"
# asks here: the Makefile installer targets, bin/validate-tool-docs,
# bin/check-alias-references and test/test_packages.bats. Before this module
# existed those were five separate parsers that disagreed with each other
# about tap-qualified names and which manifests to read.
#
# Usage:
#   manifest list <kind>   One normalized package name per line
#   manifest kinds         The kind vocabulary, one per line
#   manifest taps          Homebrew tap names declared in the Brewfile
#
# Parsing rules:
#   - Blank lines and # comments are skipped everywhere.
#   - Brewfile/Caskfile entries are `brew "name"` / `cask "name"`; a trailing
#     comment is allowed. Tap-qualified names are reduced to the last segment
#     ("oven-sh/bun/bun" -> "bun"), because that is the name that lands on PATH.
#   - npmfile/Rustfile/pacmanfile/Codefile hold one bare name per line, each
#     validated against that ecosystem's own name grammar (npm scopes, cargo
#     crate names, pacman names, publisher.extension ids).
#   - A line that matches none of the above is an error, not something to
#     skip: silently dropping unparseable lines is how the previous five
#     parsers drifted apart without anyone noticing.
#
# install/duti is deliberately not a kind. It holds `<bundle-id> <type>
# [role]` triples, is consumed directly by `duti -v`, and lists no packages.

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
readonly DOTFILES_DIR
readonly INSTALL_DIR="$DOTFILES_DIR/install"

# kind -> filename
readonly KINDS="brew cask cask-extra npm rust pacman code"

# Per-kind name grammar. These were seven hand-rolled regexes in
# test/test_packages.bats; they live here so the rule that parses a manifest
# is the same rule that validates it.
kind_pattern() {
    case "$1" in
        brew | cask | cask-extra) echo '^[A-Za-z0-9@._+-]+$' ;;
        npm) echo '^[@a-z0-9][a-z0-9._/-]*$' ;;
        rust) echo '^[a-z0-9][a-z0-9_-]*$' ;;
        pacman) echo '^[a-z0-9][a-z0-9._+-]*$' ;;
        code) echo '^[a-zA-Z0-9-]+\.[a-zA-Z0-9-]+$' ;;
        *) return 1 ;;
    esac
}

kind_file() {
    case "$1" in
        brew) echo "Brewfile" ;;
        cask) echo "Caskfile" ;;
        cask-extra) echo "Caskfile.extra" ;;
        npm) echo "npmfile" ;;
        rust) echo "Rustfile" ;;
        pacman) echo "pacmanfile" ;;
        code) echo "Codefile" ;;
        *) return 1 ;;
    esac
}

# Ruby-DSL manifests: `brew "name"` or `cask "name"`, optional trailing args
# and comment. Emits the last path segment of the name.
_list_dsl() {
    local file="$1" keyword="$2" pattern="$3" lineno=0 line name status=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
        if [[ "$line" =~ ^[[:space:]]*${keyword}[[:space:]]+\"([^\"]+)\" ]]; then
            name="${BASH_REMATCH[1]}"
            name="${name##*/}"
            if [[ ! "$name" =~ $pattern ]]; then
                echo "$file:$lineno: invalid package name: $name" >&2
                status=1
                continue
            fi
            echo "$name"
        elif [[ "$line" =~ ^[[:space:]]*tap[[:space:]]+\" ]]; then
            # Taps live in the Brewfile but are not packages; `manifest taps`
            # reads them instead.
            continue
        else
            echo "$file:$lineno: not a '$keyword' entry: $line" >&2
            status=1
        fi
    done < "$INSTALL_DIR/$file"
    return "$status"
}

# Bare-name manifests: one package per line.
_list_bare() {
    local file="$1" pattern="$2" lineno=0 line name status=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
        if [[ ! "$line" =~ ^[[:space:]]*([^[:space:]]+)[[:space:]]*$ ]]; then
            echo "$file:$lineno: not a bare package name: $line" >&2
            status=1
            continue
        fi
        name="${BASH_REMATCH[1]}"
        if [[ ! "$name" =~ $pattern ]]; then
            echo "$file:$lineno: invalid package name: $name" >&2
            status=1
            continue
        fi
        echo "$name"
    done < "$INSTALL_DIR/$file"
    return "$status"
}

cmd_list() {
    local kind="${1:-}" file pattern
    if [[ -z "$kind" ]]; then
        echo "manifest list: kind required (one of: $KINDS)" >&2
        return 2
    fi
    if ! file="$(kind_file "$kind")"; then
        echo "manifest list: unknown kind '$kind' (one of: $KINDS)" >&2
        return 2
    fi
    if [[ ! -f "$INSTALL_DIR/$file" ]]; then
        echo "manifest list: missing manifest $INSTALL_DIR/$file" >&2
        return 1
    fi

    pattern="$(kind_pattern "$kind")"
    case "$kind" in
        brew) _list_dsl "$file" brew "$pattern" ;;
        cask | cask-extra) _list_dsl "$file" cask "$pattern" ;;
        *) _list_bare "$file" "$pattern" ;;
    esac
}

cmd_kinds() {
    local kind
    for kind in $KINDS; do echo "$kind"; done
}

cmd_taps() {
    local lineno=0 line
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        if [[ "$line" =~ ^[[:space:]]*tap[[:space:]]+\"([^\"]+)\" ]]; then
            echo "${BASH_REMATCH[1]}"
        fi
    done < "$INSTALL_DIR/Brewfile"
}

show_help() {
    cat << EOF
manifest - read the install/ package manifests

Usage:
  manifest list <kind>   One normalized package name per line
  manifest kinds         The kind vocabulary, one per line
  manifest taps          Homebrew tap names declared in the Brewfile

Kinds:
  $KINDS

Exits non-zero if a manifest contains a line it cannot parse.
EOF
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        list) cmd_list "$@" ;;
        kinds) cmd_kinds ;;
        taps) cmd_taps ;;
        help | --help | -h) show_help ;;
        *)
            echo "manifest: unknown command '$cmd'" >&2
            show_help >&2
            return 2
            ;;
    esac
}

main "$@"
