#!/usr/bin/env bash
# palette - Read the colour palette every themed tool in this checkout shares.
#
# The palette used to exist as the same six hex literals re-typed in ten
# files: sketchybar's colors.sh, starship.toml, zellij's config.kdl, yazi's
# theme.toml, eza's theme.yml, atuin's theme, .zshrc's highlight styles, git's
# delta colours, bin/lib/ui.sh and a vendored bat .tmTheme. Nothing connected
# them, so "everything matches" was a claim no command could check.
#
# This module owns the data. Formats differ per tool and always will — kdl,
# toml, yaml, plist, `0xaarrggbb` for sketchybar — so this does not try to
# generate every config. It gives them one place to read from, and gives the
# Makefile's stale-ref grep a list of retired hexes to forbid.
#
# Usage:
#   palette list                     # name<TAB>hex<TAB>role
#   palette names                    # names only
#   palette get <name> [--format F]  # F: hex (default) | raw | 0x | rgb
#   palette export [prefix]          # PREFIX_NAME='#hex' shell assignments
#   palette palettes                 # the palettes this checkout ships
#   palette role <role> [--format F] # the colour filling a role (see below)
#   palette roles                    # role<TAB>colour name<TAB>hex
#
# Palette selection: PALETTE=<name> reads .config/palette/<name>.conf
# (default: the active Rice, from .config/palette/rice.sh; ADR 0003).
# PALETTE_FILE=<path> overrides both.
#
# Roles: tool themes are written once in danse's colour names, which act as
# slots ("the error colour"). .config/palette/<name>.roles maps each slot to
# one of that palette's colours; danse's map is the identity.
#
# Formats:
#   hex   #61afef      most config files
#   raw   61afef       formats that supply their own prefix
#   0x    0xff61afef   sketchybar
#   rgb   97;175;239   EZA_COLORS and other SGR truecolor strings
#
# An unknown name is an error, not an empty string: a typo in a theme should
# fail loudly rather than silently paint something black.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"

PALETTE_DIR="$DOTFILES_DIR/.config/palette"
if [[ -z "${PALETTE:-}" ]]; then
    # shellcheck source=../.config/palette/rice.sh
    . "$PALETTE_DIR/rice.sh"
    rice_select
    PALETTE="$RICE"
fi
# A name, not a path: refuse anything that could walk out of PALETTE_DIR.
if [[ -z "${PALETTE_FILE:-}" && ! "$PALETTE" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    printf 'palette: bad palette name %q\n' "$PALETTE" >&2
    exit 2
fi
PALETTE_FILE="${PALETTE_FILE:-$PALETTE_DIR/$PALETTE.conf}"
readonly PALETTE_DIR PALETTE PALETTE_FILE

# Strip comments and blanks once; every subcommand reads this.
rows() {
    [[ -f "$PALETTE_FILE" ]] || {
        printf 'palette: no such palette file: %s\n' "$PALETTE_FILE" >&2
        return 1
    }
    grep -vE '^[[:space:]]*(#|$)' "$PALETTE_FILE"
}

cmd_list() { rows | tr '|' '\t'; }

cmd_names() {
    local name rest
    while IFS='|' read -r name rest; do
        [[ -n "$name" ]] && printf '%s\n' "$name"
    done < <(rows)
    return 0
}

format_hex() {
    local hex="$1" fmt="$2" bare="${1#\#}"
    case "$fmt" in
        hex) printf '%s\n' "$hex" ;;
        raw) printf '%s\n' "$bare" ;;
        0x) printf '0xff%s\n' "$bare" ;;
        rgb) printf '%d;%d;%d\n' "0x${bare:0:2}" "0x${bare:2:2}" "0x${bare:4:2}" ;;
        *)
            printf 'palette: unknown format %q (hex|raw|0x|rgb)\n' "$fmt" >&2
            return 2
            ;;
    esac
}

cmd_get() {
    local want="${1:-}" fmt=hex name hex rest
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --format)
                # `shift 2` with no value fails under set -e and exits 1
                # without a word; say what is missing instead.
                [[ $# -ge 2 ]] || {
                    printf 'palette: --format needs a value (hex|raw|0x|rgb)\n' >&2
                    return 2
                }
                fmt="$2"
                shift 2
                ;;
            *)
                printf 'palette: unexpected argument %q\n' "$1" >&2
                return 2
                ;;
        esac
    done

    [[ -n "$want" ]] || {
        printf 'palette: get needs a colour name\n' >&2
        return 2
    }

    while IFS='|' read -r name hex rest; do
        if [[ "$name" == "$want" ]]; then
            format_hex "$hex" "$fmt"
            return
        fi
    done < <(rows)

    printf 'palette: no such colour %q (try: palette names)\n' "$want" >&2
    return 1
}

# role <role> [--format F]: the colour this palette puts in a danse-named slot.
cmd_role() {
    local want="${1:-}" roles_file="${PALETTE_FILE%.conf}.roles" role name
    [[ -n "$want" ]] || {
        printf 'palette: role needs a role name\n' >&2
        return 2
    }
    shift
    [[ -f "$roles_file" ]] || {
        printf 'palette: no role map: %s\n' "$roles_file" >&2
        return 1
    }
    while IFS='|' read -r role name; do
        if [[ "$role" == "$want" ]]; then
            cmd_get "$name" "$@"
            return
        fi
    done < <(grep -vE '^[[:space:]]*(#|$)' "$roles_file")
    printf 'palette: no such role %q in %s\n' "$want" "$roles_file" >&2
    return 1
}

cmd_roles() {
    local roles_file="${PALETTE_FILE%.conf}.roles" role name
    [[ -f "$roles_file" ]] || {
        printf 'palette: no role map: %s\n' "$roles_file" >&2
        return 1
    }
    while IFS='|' read -r role name; do
        printf '%s\t%s\t%s\n' "$role" "$name" "$(cmd_get "$name")"
    done < <(grep -vE '^[[:space:]]*(#|$)' "$roles_file")
}

cmd_palettes() {
    local f
    for f in "$PALETTE_DIR"/*.conf; do
        [[ -f "$f" ]] && basename "$f" .conf
    done
    return 0
}

# Shell assignments, for configs that are themselves shell.
cmd_export() {
    local prefix="${1:-PALETTE}" name hex rest var
    while IFS='|' read -r name hex rest; do
        # Names are kebab-case in the file; shell variables cannot be.
        var="$(printf '%s' "$name" | tr '[:lower:]-' '[:upper:]_')"
        printf "%s_%s='%s'\n" "$prefix" "$var" "$hex"
    done < <(rows)
    return 0
}

main() {
    local cmd="${1:-}"
    shift || true
    case "$cmd" in
        list) cmd_list ;;
        names) cmd_names ;;
        get) cmd_get "$@" ;;
        export) cmd_export "$@" ;;
        palettes) cmd_palettes ;;
        role) cmd_role "$@" ;;
        roles) cmd_roles ;;
        -h | --help | "")
            sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
            [[ -z "$cmd" ]] && return 2
            return 0
            ;;
        *)
            printf 'palette: unknown command %q (list|names|get|export|palettes|role|roles)\n' "$cmd" >&2
            return 2
            ;;
    esac
}

main "$@"
