#!/usr/bin/env bash
#
# platform - Unified platform detection utility
#
# Usage:
#   platform detect           # Output: macos, arch, linux, or unknown
#   platform arch             # Output: arm64, x86_64, or unknown
#   platform is-macos         # Exit 0 if macOS, 1 otherwise
#   platform is-omarchy       # Exit 0 if Omarchy (Arch + Hyprland), 1 otherwise
#   platform is-linux         # Exit 0 if Linux, 1 otherwise
#   platform is-arm64         # Exit 0 if ARM64, 1 otherwise
#   platform has <cmd>        # Exit 0 if command exists, 1 otherwise
#   platform file-mode <path> # Octal permission bits (BSD/GNU stat)
#   platform select <true> <false> <check>
#                             # Output <true> if check passes, <false> otherwise
#
# Examples:
#   platform detect                    # "macos"
#   platform is-macos && echo "Mac!"   # Conditional
#   platform has brew && brew update   # Check before running
#   platform select /opt/homebrew /usr/local "platform is-arm64"

set -euo pipefail

detect_os() {
    case "$OSTYPE" in
        darwin*)
            echo "macos"
            ;;
        linux*)
            if [[ -f /etc/arch-release ]]; then
                echo "arch"
            else
                echo "linux"
            fi
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

# Omarchy (basecamp/omarchy) is Arch + Hyprland. `detect` still says "arch"
# on it on purpose: `make arch` is the right path. Three markers, any one is
# enough:
#   - ~/.local/share/omarchy   the git checkout Omarchy 3.x installed into
#   - /usr/share/omarchy       Omarchy 4.x, installed as the `omarchy` package
#   - /etc/os-release          ID=omarchy, which 4.x writes (3.x did not)
# The system paths are overridable so tests can run on an Omarchy machine.
OMARCHY_SYSTEM_DIR="${PLATFORM_OMARCHY_SYSTEM_DIR:-/usr/share/omarchy}"
OS_RELEASE_FILE="${PLATFORM_OS_RELEASE:-/etc/os-release}"

is_omarchy() {
    [[ -d "$HOME/.local/share/omarchy" ]] ||
        [[ -d "$OMARCHY_SYSTEM_DIR" ]] ||
        { [[ -r "$OS_RELEASE_FILE" ]] && grep -qi '^\(ID\|NAME\)=.*omarchy' "$OS_RELEASE_FILE"; }
}

# BSD and GNU stat spell the octal-permissions format differently, and the
# obvious `stat -f ... || stat -c ...` fallback does not work: GNU stat
# accepts -f (as --file-system) and exits 0, so the BSD form silently wins
# on Linux and prints the wrong thing.
file_mode() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        stat -f "%Lp" "$1" 2>/dev/null
    else
        stat -c "%a" "$1" 2>/dev/null
    fi
}

detect_arch() {
    case "$(uname -m)" in
        arm64|aarch64)
            echo "arm64"
            ;;
        x86_64|amd64)
            echo "x86_64"
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        detect)
            detect_os
            ;;
        arch)
            detect_arch
            ;;
        is-macos)
            [[ "$OSTYPE" =~ ^darwin ]]
            ;;
        is-omarchy)
            is_omarchy
            ;;
        is-linux)
            [[ "$OSTYPE" =~ ^linux ]]
            ;;
        is-arm64)
            [[ "$(uname -m)" == "arm64" || "$(uname -m)" == "aarch64" ]]
            ;;
        has)
            command -v "$1" >/dev/null 2>&1
            ;;
        file-mode)
            file_mode "$1"
            ;;
        select)
            # Usage: platform select <if-true> <if-false> <check-command>
            local if_true="$1"
            local if_false="$2"
            shift 2
            # shellcheck disable=SC2294 # eval needed: check-command arrives as a single string
            if eval "$@" 2>/dev/null; then
                echo "$if_true"
            else
                echo "$if_false"
            fi
            ;;
        help|--help|-h)
            cat << 'EOF'
platform - Unified platform detection utility

Usage:
  platform detect           Output: macos, arch, linux, or unknown
  platform arch             Output: arm64, x86_64, or unknown
  platform is-macos         Exit 0 if macOS, 1 otherwise
  platform is-omarchy       Exit 0 if Omarchy (3.x checkout or 4.x package), 1 otherwise
  platform is-linux         Exit 0 if Linux, 1 otherwise
  platform is-arm64         Exit 0 if ARM64, 1 otherwise
  platform has <cmd>        Exit 0 if command exists, 1 otherwise
  platform file-mode <path> Octal permission bits (BSD/GNU stat)
  platform select <t> <f> <check>
                            Output <t> if check passes, <f> otherwise

Examples:
  platform detect
  platform is-macos && echo "Running on Mac"
  platform has brew && brew update
  platform select /opt/homebrew /usr/local "platform is-arm64"
EOF
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            echo "Run 'platform help' for usage" >&2
            exit 1
            ;;
    esac
}

main "$@"
