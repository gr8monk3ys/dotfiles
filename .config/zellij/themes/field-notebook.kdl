// Generated by bin/rice-themes from .config/palette/templates/zellij.kdl
// for the field-notebook rice. Edit the template, then `bin/rice-themes render`.
// Zellij loads every file in themes/; the `zellij` shell function in
// .config/zsh/rice.zsh starts new sessions with `--theme <rice>`.
themes {
    field-notebook {
        fg "#eceef1"
        bg "#111317"
        black "#111317"
        red "#e87c7c"
        green "#42a979"
        yellow "#e3b25e"
        blue "#7aa0e6"
        magenta "#b796c8"
        cyan "#5fb3a1"
        white "#eceef1"
        orange "#e08d55"
    }
}
