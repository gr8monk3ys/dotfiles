# Ghostty Terminal Configuration
# https://ghostty.org/docs/config
# Visual style inspired by: https://kskroyal.com/beautiful-mac-terminal-ghostty/

# ============================================================================
# Font Configuration
# ============================================================================
font-family = "JetBrainsMono Nerd Font"
font-size = 15
font-thicken = true

# Generous line spacing for readability (article uses 35%, tuned down for splits)
adjust-cell-height = 20%

# Font features (ligatures)
font-feature = calt
font-feature = liga
font-feature = dlig

# ============================================================================
# Theme & Colors
# ============================================================================
# Adaptive light/dark theme — follows macOS appearance automatically
theme = light:Horizon Bright,dark:Broadcast

# Frosted glass effect
background-opacity = 0.8
background-blur = 90

# Wide color gamut for richer colors on Apple displays
window-colorspace = display-p3

# Cursor
cursor-style = block
cursor-style-blink = true

# ============================================================================
# Window Configuration
# ============================================================================
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend
window-decoration = true
window-save-state = always
unfocused-split-opacity = 0.85

# macOS specific
macos-titlebar-style = transparent
macos-option-as-alt = true

# ============================================================================
# Shell Integration
# ============================================================================
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ============================================================================
# Scrollback & Performance
# ============================================================================
scrollback-limit = 100000
copy-on-select = clipboard
mouse-scroll-multiplier = 2

# GPU rendering (Ghostty's main advantage)
# gtk-single-instance = true  # Linux/GTK only — ignored on macOS

# ============================================================================
# Keybindings — optimized for multi-pane AI sessions
# ============================================================================
# Use super (cmd on macOS) as modifier

# --- Pane management (built-in multiplexing) ---
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface

# Vim-style pane navigation (h/j/k/l)
keybind = super+h=goto_split:left
keybind = super+j=goto_split:bottom
keybind = super+k=goto_split:top
keybind = super+l=goto_split:right

# Pane resizing (critical for AI sessions — adjust output vs input panes)
keybind = super+ctrl+h=resize_split:left,40
keybind = super+ctrl+l=resize_split:right,40
keybind = super+ctrl+k=resize_split:up,20
keybind = super+ctrl+j=resize_split:down,20

# Equalize splits after resizing
keybind = super+shift+e=equalize_splits

# Zoom into a single pane (like tmux prefix+z) — essential for reading AI output
keybind = super+enter=toggle_split_zoom

# --- Tab management ---
keybind = super+t=new_tab
keybind = super+shift+left=previous_tab
keybind = super+shift+right=next_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5

# --- Font size ---
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size

# --- Clipboard ---
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# --- Scrolling ---
keybind = super+up=scroll_page_up
keybind = super+down=scroll_page_down
keybind = super+home=scroll_to_top
keybind = super+end=scroll_to_bottom

# --- Quick actions ---
keybind = super+f=toggle_fullscreen
keybind = super+shift+c=open_config

# ============================================================================
# Misc
# ============================================================================
confirm-close-surface = false
mouse-hide-while-typing = true
focus-follows-mouse = false
link-url = true
