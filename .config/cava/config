# cava - console audio visualiser.
#
# Colours are .config/palette/danse.conf, and the gradient is the painting's
# own progression: the ultramarine sky at the quiet end, up through the
# viridian ground, to the vermilion figures at the peaks.
#
# On macOS cava captures an *input* device. Without an audio loopback that
# means the microphone, so out of the box this visualises the room, not your
# music. See the README for the BlackHole setup that fixes it.

[general]
framerate = 60
autosens = 1
overshoot = 20
# 0 lets cava fill whatever width the pane has, which is the right answer
# under a tiling window manager where that width is not up to cava.
bars = 0

[input]
method = portaudio
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[smoothing]
noise_reduction = 77

[color]
background = default
foreground = default
gradient = 1
gradient_count = 8
gradient_color_1 = '#2b4468'
gradient_color_2 = '#61afef'
gradient_color_3 = '#56b6c2'
gradient_color_4 = '#476a62'
gradient_color_5 = '#98c379'
gradient_color_6 = '#e5c07b'
gradient_color_7 = '#d98c5c'
gradient_color_8 = '#e06a51'
