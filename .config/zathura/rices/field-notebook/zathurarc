# Generated by bin/rice-themes from .config/palette/templates/zathurarc
# for the field-notebook rice. Edit the template, then `bin/rice-themes render`.
# The `zathura` shell function in .config/zsh/rice.zsh opens zathura with
# `-c` on this directory; ../../zathurarc (a link to one of these) is what a
# zathura started outside the shell reads.
# See `man zathurarc'

# One page per row by default
set pages-per-row 1

#stop at page boundries
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 0.01

# maps
map r reload
map p print
map i recolor
map J zoom out
map K zoom in
map R rotate


#zoom settings
set zoom-min 10
set guioptions ""

set font "inconsolata 15"

# Colours: the field-notebook palette's ground, text and status colours.
set default-bg "#0d0f12"
set default-fg "#eceef1"

set statusbar-fg "#eceef1"
set statusbar-bg "#292c32"

set inputbar-bg "#111317"
set inputbar-fg "#eceef1"

set notification-error-bg "#e87c7c"
set notification-error-fg "#0d0f12"

set notification-warning-bg "#e3b25e"
set notification-warning-fg "#0d0f12"

set highlight-color "#e3b25e"
set highlight-active-color "#7aa0e6"

set completion-highlight-fg "#0d0f12"
set completion-highlight-bg "#7aa0e6"

set completion-bg "#111317"
set completion-fg "#eceef1"

set notification-bg "#42a979"
set notification-fg "#0d0f12"

# Pages are drawn in the palette's ground and text colours.
set recolor "true"
set recolor-lightcolor "#0d0f12"
set recolor-darkcolor "#eceef1"
set recolor-reverse-video "true"
set recolor-keephue "true"

set selection-clipboard clipboard
set render-loading "false"
