// Generated by bin/rice-themes from .config/palette/templates/zellij.kdl
// for the {{rice}} rice. Edit the template, then `bin/rice-themes render`.
// Zellij loads every file in themes/; the `zellij` shell function in
// .config/zsh/rice.zsh starts new sessions with `--theme <rice>`.
themes {
    {{rice}} {
        fg "{{fg}}"
        bg "{{bg}}"
        black "{{bg}}"
        red "{{vermilion}}"
        green "{{green}}"
        yellow "{{yellow}}"
        blue "{{blue}}"
        magenta "{{magenta}}"
        cyan "{{cyan}}"
        white "{{fg}}"
        orange "{{terracotta}}"
    }
}
