# Homebrew Brewfile
# Command-line tools and development packages
# Install with: brew bundle --file=install/Brewfile

# ============================================================================
# Taps (Third-party repositories)
# ============================================================================
tap "dominikbraun/timetrace"           # Time tracking
tap "homebrew-zathura/zathura"         # Zathura plugins
tap "nikitabobko/tap"                  # AeroSpace window manager
tap "hudochenkov/sshpass"              # sshpass (not in homebrew/core by policy)
tap "oven-sh/bun"                      # Bun JavaScript runtime
tap "psharma04/dorion"
tap "stripe/stripe-cli"                # Stripe CLI                 # Discord client
tap "sylvanfranklin/srhd"              # Simple hotkey daemon
tap "vldmrkl/formulae"                 # Additional tools
tap "FelixKratz/formulae"              # SketchyBar status bar, JankyBorders

# ============================================================================
# Core System Dependencies
# ============================================================================
brew "ca-certificates"                 # SSL/TLS certificates.
brew "dbus"                            # Message bus system (no restart_service: fails on a fresh machine).
brew "gnupg"                           # PGP encryption.

# ============================================================================
# Graphics & UI Libraries
# ============================================================================
brew "freetype"                        # Font rendering.
brew "glib"                            # Core library.
brew "harfbuzz"                        # Text shaping.
brew "librsvg"                         # SVG rendering.
brew "adwaita-icon-theme"              # Icon theme.
brew "at-spi2-core"                    # Accessibility toolkit.
brew "gsettings-desktop-schemas"       # Desktop settings.

# ============================================================================
# Development Tools
# ============================================================================

## Build Systems & Compilers
brew "gcc"                             # GNU Compiler Collection.
brew "bear"                            # Generate compilation database.
brew "meson"                           # Build system.
brew "tbb"                             # Threading Building Blocks.
brew "xcodegen"                        # Xcode project generator.

## Version Control & Git Tools
brew "gh"                              # Official GitHub CLI for PRs, issues, and API access from the terminal; used by helper scripts. Alternatives: hub (unmaintained).
brew "lazygit"                         # Fast TUI for staging, rebasing, and browsing history when a full jj/git CLI round-trip is overkill. Alternatives: gitui, tig.
brew "lazydocker"                      # Same UX as lazygit for containers; quick logs/exec without memorizing docker flags. Alternatives: ctop, docker desktop dashboard.
# gh-dash is a gh CLI extension: gh extension install dlvhdr/gh-dash

## Language Servers & Development Tools
brew "rustup"                          # The Rust toolchain itself; nothing else installs `cargo`, and `install/Rustfile` needs it. `make rust-packages` runs `rustup default stable` on first use.
brew "rust-analyzer"                   # Rust language server.
brew "lua-language-server"             # Lua language server.
brew "python-lsp-server"               # Python language server.
brew "typescript"                      # TypeScript compiler (tsc) available globally for tooling.

# ============================================================================
# Programming Languages & Runtimes
# ============================================================================

## JavaScript/TypeScript
brew "node"                            # Node.js runtime required by npm global tooling and editors.
brew "deno"                            # Secure-by-default TS runtime for one-off scripts. Alternatives: node, bun.
brew "oven-sh/bun/bun"                 # Fast all-in-one JS runtime/bundler/test runner for scripts and tooling. Alternatives: node (kept), deno (kept).
# pnpm and yarn installed via npmfile to avoid duplication

## Python
brew "python@3.12"                     # Python 3.12.
brew "python@3.13"                     # Python 3.13 (latest).
brew "poetry"                          # Python dependency management.
brew "pipx"                            # Install Python apps in isolation.
brew "uv"                              # Fast Python package/venv manager; gradually replacing pip/poetry workflows. Alternatives: pip, poetry (kept for legacy projects).
brew "uvicorn"                         # ASGI server.

## Haskell
brew "ghc"                             # Glasgow Haskell Compiler.
brew "ghcup"                           # Haskell toolchain installer.
brew "haskell-stack"                   # Haskell build tool.

## Other Languages
brew "ruby"                            # Ruby programming language.
brew "r"                               # R statistical language.
brew "zig"                             # Zig programming language.
brew "luarocks"                        # Lua package manager.

# ============================================================================
# Mobile Development
# ============================================================================
brew "cocoapods"                       # iOS dependency manager.
brew "ios-deploy"                      # Deploy iOS apps.
brew "libimobiledevice"                # iOS device communication.

# ============================================================================
# Containerization
# ============================================================================
brew "colima"                          # Container runtime on macOS.
brew "docker"                          # Container platform.
brew "docker-compose"                  # Multi-container Docker apps.

# ============================================================================
# Text Editors & IDEs
# ============================================================================
brew "neovim"                          # cmd=nvim tier=core Primary editor. Lua config with lazy.nvim, LSP, treesitter, conform formatting. Alternatives: vim, helix, vscodium (GUI fallback).

# ============================================================================
# Shell & Terminal Tools
# ============================================================================
brew "tmux"                            # Backup multiplexer kept for SSH/remote boxes and muscle-memory compatibility; zellij is primary locally. Alternatives: zellij (primary), screen.
brew "zsh-syntax-highlighting"         # Zsh syntax highlighting (also loaded via zinit); styled by `ZSH_HIGHLIGHT_STYLES` in `.zshrc`.
brew "starship"                        # Shell prompt: fast single binary, one TOML config, actively developed (Powerlevel10k, the previous prompt, is in maintenance mode). Alternatives: powerlevel10k, oh-my-posh, pure.
brew "hudochenkov/sshpass/sshpass"     # Non-interactive SSH password auth for scripted access to hosts without key auth; from `hudochenkov/sshpass`, as homebrew/core declines to carry it.
brew "stripe/stripe-cli/stripe"        # Stripe CLI for testing webhooks and API calls locally; from the `stripe/stripe-cli` tap.
brew "fzf"                             # tier=essential Fuzzy finder powering ctrl-r/ctrl-t, fzf-tab completion menus, and the f/fv helper functions; themed via FZF_DEFAULT_OPTS. Alternatives: skim, peco.
brew "dockutil"                        # Rebuilds the Dock from a script (`.config/macos/dock.sh`) instead of dragging icons on every new machine.
brew "duti"                            # Applies the file-type → app associations in `install/duti` (`make duti`) so a fresh machine opens code, markdown and media in the intended apps without clicking through Finder.

# ============================================================================
# File & Text Search
# ============================================================================
brew "fd"                              # tier=essential Fast, gitignore-aware find with sane syntax; used directly (find is not shadowed). Alternatives: find, fselect.
brew "ripgrep"                         # cmd=rg tier=essential Fast recursive grep used by editor pickers and scripts; grep itself is not shadowed. Alternatives: grep, ag, ack.
brew "shellcheck"                      # Static analysis for shell scripts; `make verify` and CI both gate on it.
brew "jq"                              # The standard JSON processor; scripted everywhere, so kept canonical (jnv adds interactivity). Alternatives: jaq, gojq, dasel.
brew "tree"                            # Directory tree viewer.

# ============================================================================
# Modern CLI Replacements (Rust-powered)
# ============================================================================
brew "eza"                             # tier=essential Modern ls with icons, git status, and tree view; aliased to ls and used in fzf-tab previews. Alternatives: lsd, plain ls.
brew "bat"                             # tier=essential cat with syntax highlighting and paging; themed from `.config/palette/`, and the fzf/dotfiles-why previewer. Alternatives: cat, moar.
brew "zoxide"                          # tier=essential Frecency-based cd (aliased to cd) replacing the old z.lua setup. Alternatives: z.lua (removed), autojump.
brew "git-delta"                       # cmd=delta tier=next-gen Syntax-highlighting pager for git/jj diffs, themed from `.config/palette/` to match bat. Alternatives: difftastic (kept for structural diffs), diff-so-fancy.
brew "dust"                            # Readable du with a usage graph; du itself is not shadowed. Alternatives: du, ncdu, gdu.
brew "bottom"                          # Graphical process/system monitor (btm); top is not shadowed. Alternatives: htop, btop, glances.
brew "btop"                            # Interactive resource monitor. Themed from `.config/palette/`, with a transparent background so it inherits Ghostty's blur rather than punching an opaque rectangle through it. Alternatives: bottom (kept, non-interactive use), htop, top.
brew "procs"                           # Readable, searchable ps; ps itself is not shadowed. Alternatives: ps.
brew "sd"                              # Intuitive find-and-replace; sed stays unshadowed because scripts depend on it. Alternatives: sed.
brew "hyperfine"                       # Statistical CLI benchmarking; used to measure shell startup alongside dotfiles-bench-shell. Alternatives: time, bench.
brew "tokei"                           # Code statistics tool.
brew "watchexec"                       # File watcher for development.
brew "wget"                            # Non-interactive downloader; `.config/wget/.wgetrc` sets timestamping, retries and timeouts, and is found via `$WGETRC` exported from `.zshenv`.

# ============================================================================
# Next-Gen Modern Tools (2024+)
# ============================================================================
brew "yazi"                            # tier=next-gen Primary terminal file manager: async, image previews, themed from `.config/palette/`. Alternatives: ranger, lf, nnn, broot (kept for tree-jumps).
brew "jj"                              # tier=next-gen Jujutsu: Git-compatible VCS with first-class undo, anonymous branches, and automatic rebases; primary local workflow, git remains the wire format. Alternatives: git alone.
brew "zellij"                          # tier=next-gen Primary terminal multiplexer: sane defaults, discoverable keybindings, floating panes, themed from `.config/palette/`. Alternatives: tmux (kept as backup).
brew "navi"                            # tier=additional Interactive cheatsheets at the prompt (ctrl-g) for rarely-used commands. Alternatives: tldr/tealdeer (kept).
brew "broot"                           # tier=additional Tree navigation with fuzzy search for jumping deep into big repos. Alternatives: yazi (primary file manager).
brew "tealdeer"                        # cmd=tldr tier=additional Fast Rust tldr client for example-first help; man stays canonical. Alternatives: tldr (node).
brew "gping"                           # tier=additional Graphical ping with history.
brew "ouch"                            # tier=additional Universal archive compress/decompress.

# ============================================================================
# Modern CLI Tools (2025+ additions)
# ============================================================================

## Data & JSON
brew "jnv"                             # Interactive JSON navigator with jq.
brew "glow"                            # Renders markdown in the terminal; used for README/doc reading. Alternatives: bat (plain highlight).
brew "csvlens"                         # Interactive CSV viewer.
brew "xsv"                             # Fast CSV toolkit (Rust).

## System & Network
brew "duf"                             # Readable df with colored table output; df itself is not shadowed. Alternatives: df.
brew "doggo"                           # Modern DNS client with readable output; dig is not shadowed since scripts parse it. Alternatives: dig, dog.
brew "bandwhich"                       # Network utilization by process.
brew "viddy"                           # Modern watch command with diffs.
brew "trippy"                          # mtr-style network diagnostic TUI (aliased via sudo trip). Alternatives: mtr, traceroute.

## Developer Productivity
brew "just"                            # Ergonomic command runner for project-local recipes; make stays for this repo itself. Alternatives: make, task.
brew "difftastic"                      # Structural, syntax-aware diffs for review; delta covers day-to-day paging. Alternatives: git-delta (pager).
brew "grex"                            # Generate regex from examples.
brew "topgrade"                        # One command to update brew/npm/cargo/etc.; complements dotfiles-update. Alternatives: dotfiles-update (repo script).
brew "gum"                             # Styled headers, prompts, and spinners for shell scripts; `bin/lib/ui.sh` upgrades script output with it when present (plain ANSI fallback keeps tests/CI stable). Alternatives: hand-rolled ANSI escapes (the fallback).
brew "fastfetch"                       # Fast, maintained neofetch successor for a system-info splash; run on demand via the `ff` alias rather than on shell start to protect startup time. Alternatives: neofetch (unmaintained), macchina.

# ============================================================================
# Shell History & Environment
# ============================================================================
brew "atuin"                           # tier=next-gen SQLite-backed shell history with fuzzy search and optional sync; replaces plain ctrl-r. Themed from `.config/palette/` via a custom theme file. Alternatives: mcfly, plain HISTFILE (still kept as fallback).
brew "direnv"                          # Per-directory env vars; loads per-project dev environments from `.envrc`. Alternatives: shadowenv.

# ============================================================================
# Version Management
# ============================================================================
brew "mise"                            # Single version manager for node/python/etc.; replaces asdf/pyenv/nvm sprawl (n is kept only for the Makefile bootstrap). Alternatives: asdf, nvm+pyenv+rbenv.

