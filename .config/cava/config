# cava - console audio visualiser, Monochrome 43 (the default). The older
# danse gradient is ~/.config/cava/danse: cava -p ~/.config/cava/danse
#
# After 43PR/dotfiles' cava config (MIT): bars that run from faint grey at the
# quiet end to white at the peaks, colours from
# .config/palette/monochrome-43.conf. The shaders/ and themes/ beside this
# file are cava's own upstream examples (MIT); 43PR ships the same copies.
#
# [input] method is deliberately unset, so each platform's cava build picks
# its own default backend (the default config pins portaudio for macOS). On
# macOS that captures an *input* device - see the README.

[general]
framerate = 60
# 43PR's fixed sensitivity rather than autosens: quiet passages stay low
# instead of being stretched to the full height.
autosens = 0
sensitivity = 60
overshoot = 20
# 0 lets cava fill whatever width the pane has, which is the right answer
# under a tiling window manager where that width is not up to cava.
bars = 0
bar_width = 2
bar_spacing = 1

[input]
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[smoothing]
noise_reduction = 90

[color]
background = default
foreground = default
gradient = 1
gradient_count = 4
gradient_color_1 = '#4a4a4a'
gradient_color_2 = '#6f6f6f'
gradient_color_3 = '#c2c2c2'
gradient_color_4 = '#ffffff'
