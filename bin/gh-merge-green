#!/usr/bin/env bash
# gh-merge-green - merge a PR only after every check on its head has passed.
#
# Usage: gh-merge-green <pr> [-R owner/repo] [gh pr merge flags...]
#        (merge flags default to --squash --delete-branch)
#
# `gh pr checks --watch --required` returns at once on a repo with no
# required checks, and "no checks yet" is not green. This waits on all
# checks, refuses a head with none, and merges that exact head commit.
set -euo pipefail

die() { printf 'gh-merge-green: %s\n' "$*" >&2; exit 1; }

[[ $# -ge 1 && $1 != -* ]] || die "usage: gh-merge-green <pr> [-R owner/repo] [merge flags...]"
pr=$1
shift
repo=()
if [[ ${1:-} == -R || ${1:-} == --repo ]]; then
    [[ $# -ge 2 ]] || die "-R needs owner/repo"
    repo=(-R "$2")
    shift 2
fi
merge_flags=("$@")
((${#merge_flags[@]})) || merge_flags=(--squash --delete-branch)

head=$(gh pr view "$pr" ${repo[@]+"${repo[@]}"} --json headRefOid -q .headRefOid)
[[ $head =~ ^[0-9a-f]{40}$ ]] || die "could not read the head commit of #$pr"

checks=$(gh pr checks "$pr" ${repo[@]+"${repo[@]}"} --json name -q length 2>/dev/null || echo 0)
((checks > 0)) || die "#$pr has no checks on ${head:0:8}; not merging. Retry once CI has started."

gh pr checks "$pr" ${repo[@]+"${repo[@]}"} --watch --fail-fast --interval 15 ||
    die "#$pr: checks did not all pass on ${head:0:8}; not merging."

gh pr merge "$pr" ${repo[@]+"${repo[@]}"} --match-head-commit "$head" "${merge_flags[@]}"
