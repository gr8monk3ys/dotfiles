# Homebrew Caskfile — day-one desktop
# GUI applications a fresh macOS machine needs before it is usable.
# Applied by `make cask-apps` (part of `make macos`).
# Everything optional lives in Caskfile.extra (`make cask-apps-extra`).
# Install by hand with: brew bundle --file=install/Caskfile

# ============================================================================
# Window Management & System Utilities
# ============================================================================
cask "aerospace"                       # i3-style tiling window manager for macOS without disabling SIP; integrates with SketchyBar workspaces. Alternatives: yabai (needs SIP changes), Rectangle.
cask "karabiner-elements"              # Low-level keyboard remapping (hyper key, hjkl arrows). Alternatives: BetterTouchTool.
cask "raycast"                         # Spotlight replacement: launcher, clipboard history, window commands, extensions. Alternatives: Alfred, Spotlight.

# ============================================================================
# Terminals
# ============================================================================
cask "ghostty"                         # Primary terminal: GPU-accelerated, Zig-based, native macOS feel; themed from `.config/palette/`, with frosted glass. Alternatives: kitty, wezterm, alacritty.

# ============================================================================
# Web Browsers
# ============================================================================
cask "zen"                             # Zen browser (privacy-focused).
cask "firefox"                         # Primary browser, hardened with an arkenfox-based user.js. Alternatives: brave-browser, zen (both installed as alternates).
cask "brave-browser"                   # Privacy-focused Chromium browser.

# ============================================================================
# Development Tools
# ============================================================================
cask "vscodium"                        # Telemetry-free VS Code build as the GUI editor fallback; extensions pinned in install/Codefile. Alternatives: vscode.
cask "docker-desktop"                  # Docker Desktop — the container runtime plus Docker CLI; used for local services and the fleet's containerised projects.

# ============================================================================
# Notes, Security & Sync
# ============================================================================
cask "obsidian"                        # Markdown knowledge base on plain files — survives app churn. Alternatives: logseq, notion.
cask "keepassxc"                       # Offline, open-source password vault; pass covers CLI secrets. Alternatives: 1password, bitwarden.
cask "proton-drive"                    # End-to-end encrypted cloud storage.

# ============================================================================
# Music
# ============================================================================
cask "tidal"                           # Music streaming service.

# ============================================================================
# Fonts
# ============================================================================
cask "font-jetbrains-mono-nerd-font"   # Primary monospace Nerd Font: Ghostty and SketchyBar are set in it.
cask "font-fira-code-nerd-font"        # Fira Code Nerd Font, for ligatures.
