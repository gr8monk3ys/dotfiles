#!/usr/bin/env bash
#
# platform - Unified platform detection utility
#
# Usage:
#   platform detect           # Output: macos, arch, linux, or unknown
#   platform describe         # Human-readable OS name and version
#   platform arch             # Output: arm64, x86_64, or unknown
#   platform is-macos         # Exit 0 if macOS, 1 otherwise
#   platform is-omarchy       # Exit 0 if Omarchy (Arch + Hyprland), 1 otherwise
#   platform is-arm64         # Exit 0 if ARM64, 1 otherwise
#   platform has <cmd>        # Exit 0 if command exists, 1 otherwise
#   platform file-mode <path> # Octal permission bits (BSD/GNU stat)
#   platform select <true> <false> <check>
#                             # Output <true> if check passes, <false> otherwise
#
# Examples:
#   platform detect                    # "macos"
#   platform is-macos && echo "Mac!"   # Conditional
#   platform has brew && brew update   # Check before running
#   platform select /opt/homebrew /usr/local "platform is-arm64"

set -euo pipefail

detect_os() {
    case "$OSTYPE" in
        darwin*)
            echo "macos"
            ;;
        linux*)
            if [[ -f /etc/arch-release ]]; then
                echo "arch"
            else
                echo "linux"
            fi
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

# Omarchy (basecamp/omarchy) is Arch + Hyprland. It does not write its own
# /etc/os-release; its marker is the checkout it installs into. `detect`
# still says "arch" on it on purpose: `make arch` is the right path.
is_omarchy() {
    [[ -d "$HOME/.local/share/omarchy" ]] ||
        { [[ -r /etc/os-release ]] && grep -qi '^\(ID\|NAME\)=.*omarchy' /etc/os-release; }
}

# BSD and GNU stat spell the octal-permissions format differently, and the
# obvious `stat -f ... || stat -c ...` fallback does not work: GNU stat
# accepts -f (as --file-system) and exits 0, so the BSD form silently wins
# on Linux and prints the wrong thing.
file_mode() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        stat -f "%Lp" "$1" 2>/dev/null
    else
        stat -c "%a" "$1" 2>/dev/null
    fi
}

# The OS as a person would name it, for reports: "macOS 15.5", the distro's
# PRETTY_NAME, or the raw $OSTYPE when nothing better is known — "unknown"
# alone is useless in a bug report. Lives here so no caller has to know that
# macOS answers through sw_vers and Linux through /etc/os-release.
describe_os() {
    case "$(detect_os)" in
        macos)
            printf 'macOS %s\n' "$(sw_vers -productVersion 2>/dev/null || echo unknown)"
            ;;
        arch|linux)
            if [[ -r /etc/os-release ]]; then
                # shellcheck disable=SC1091 # system file, not in the repo
                (. /etc/os-release && echo "${PRETTY_NAME:-${NAME:-Linux}}")
            else
                echo "Linux"
            fi
            ;;
        *)
            echo "$OSTYPE"
            ;;
    esac
}

detect_arch() {
    case "$(uname -m)" in
        arm64|aarch64)
            echo "arm64"
            ;;
        x86_64|amd64)
            echo "x86_64"
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        detect)
            detect_os
            ;;
        describe)
            describe_os
            ;;
        arch)
            detect_arch
            ;;
        is-macos)
            [[ "$OSTYPE" =~ ^darwin ]]
            ;;
        is-omarchy)
            is_omarchy
            ;;
        is-arm64)
            [[ "$(uname -m)" == "arm64" || "$(uname -m)" == "aarch64" ]]
            ;;
        has)
            command -v "$1" >/dev/null 2>&1
            ;;
        file-mode)
            file_mode "$1"
            ;;
        select)
            # Usage: platform select <if-true> <if-false> <check-command>
            local if_true="$1"
            local if_false="$2"
            shift 2
            # shellcheck disable=SC2294 # eval needed: check-command arrives as a single string
            if eval "$@" 2>/dev/null; then
                echo "$if_true"
            else
                echo "$if_false"
            fi
            ;;
        help|--help|-h)
            cat << 'EOF'
platform - Unified platform detection utility

Usage:
  platform detect           Output: macos, arch, linux, or unknown
  platform describe         Human-readable OS name and version
  platform arch             Output: arm64, x86_64, or unknown
  platform is-macos         Exit 0 if macOS, 1 otherwise
  platform is-omarchy       Exit 0 if Omarchy (~/.local/share/omarchy), 1 otherwise
  platform is-arm64         Exit 0 if ARM64, 1 otherwise
  platform has <cmd>        Exit 0 if command exists, 1 otherwise
  platform file-mode <path> Octal permission bits (BSD/GNU stat)
  platform select <t> <f> <check>
                            Output <t> if check passes, <f> otherwise

Examples:
  platform detect
  platform is-macos && echo "Running on Mac"
  platform has brew && brew update
  platform select /opt/homebrew /usr/local "platform is-arm64"
EOF
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            echo "Run 'platform help' for usage" >&2
            exit 1
            ;;
    esac
}

main "$@"
