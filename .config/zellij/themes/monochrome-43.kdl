// Generated by bin/rice-themes from .config/palette/templates/zellij.kdl
// for the monochrome-43 rice. Edit the template, then `bin/rice-themes render`.
// Zellij loads every file in themes/; the `zellij` shell function in
// .config/zsh/rice.zsh starts new sessions with `--theme <rice>`.
themes {
    monochrome-43 {
        fg "#e6eaf2"
        bg "#000000"
        black "#000000"
        red "#ff003c"
        green "#c2c2c2"
        yellow "#f7768e"
        blue "#7aa2f7"
        magenta "#ffffff"
        cyan "#8b93a7"
        white "#e6eaf2"
        orange "#f7768e"
    }
}
