// Generated by bin/rice-themes from .config/palette/templates/zellij.kdl
// for the danse rice. Edit the template, then `bin/rice-themes render`.
// Zellij loads every file in themes/; the `zellij` shell function in
// .config/zsh/rice.zsh starts new sessions with `--theme <rice>`.
themes {
    danse {
        fg "#abb2bf"
        bg "#282c34"
        black "#282c34"
        red "#e06a51"
        green "#98c379"
        yellow "#e5c07b"
        blue "#61afef"
        magenta "#c678dd"
        cyan "#56b6c2"
        white "#abb2bf"
        orange "#d98c5c"
    }
}
