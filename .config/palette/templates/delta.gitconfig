# Generated by bin/rice-themes from .config/palette/templates/delta.gitconfig
# for the {{rice}} rice. Edit the template, then `bin/rice-themes render`.
#
# A delta feature, included from .config/git/config. .config/zsh/rice.zsh
# sets DELTA_FEATURES=rice-<rice>, which picks one of these per shell.
[delta "rice-{{rice}}"]
	syntax-theme = {{rice}}
	plus-style = "syntax {{diff-add}}"
	plus-emph-style = "syntax {{green}}"
	minus-style = "syntax {{diff-del}}"
	minus-emph-style = "syntax {{vermilion}}"
	line-numbers-minus-style = "{{vermilion}}"
	line-numbers-plus-style = "{{green}}"
	line-numbers-zero-style = "{{comment}}"
	hunk-header-decoration-style = "{{blue}} box"
	file-style = "bold {{blue}}"
