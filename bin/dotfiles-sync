#!/usr/bin/env bash
# dotfiles-sync - Lightweight automated sync for launchd
#
# This script is designed for unattended execution via launchd.
# For interactive updates, use dotfiles-update instead.
#
# Usage: dotfiles-sync
#
# Behavior:
#   - Pulls git changes if available
#   - Skips silently if uncommitted changes exist
#   - Shows macOS notification only when something happens
#   - Silent when already up to date

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"
# shellcheck source=lib/git-sync.sh
source "$SCRIPT_DIR/lib/git-sync.sh"

# Send macOS notification
notify() {
    local subtitle="$1"
    local message="$2"
    osascript -e "display notification \"$message\" with title \"Dotfiles\" subtitle \"$subtitle\""
}

# Main sync logic
#
# This is the notification adapter over git-sync.sh: it maps the same states
# dotfiles-update reports on the terminal to macOS notifications, and stays
# deliberately silent when nothing happened.
main() {
    git_sync_apply "$DOTFILES_DIR"

    case "$GIT_SYNC_STATE" in
        "$GIT_SYNC_CLEAN_UPTODATE")
            # Nothing happened; say nothing.
            exit 0
            ;;
        "$GIT_SYNC_NO_UPSTREAM")
            # Not actionable daily and not worth a notification; dotfiles-doctor
            # surfaces it instead.
            exit 0
            ;;
        "$GIT_SYNC_DIRTY")
            notify "Skipped" "Uncommitted changes present"
            exit 0
            ;;
        "$GIT_SYNC_PULLED")
            notify "Updated" "Pulled $GIT_SYNC_BEHIND commit(s) successfully"
            exit 0
            ;;
        "$GIT_SYNC_MISSING_DIR")
            notify "Error" "$GIT_SYNC_DETAIL"
            exit 1
            ;;
        "$GIT_SYNC_NOT_A_REPO")
            notify "Error" "Not a git repository"
            exit 1
            ;;
        "$GIT_SYNC_FETCH_FAILED")
            notify "Error" "Failed to fetch from remote"
            exit 1
            ;;
        "$GIT_SYNC_DIVERGED")
            notify "Warning" "Local and remote have diverged - manual merge required"
            exit 1
            ;;
        "$GIT_SYNC_PULL_FAILED")
            notify "Error" "Failed to pull changes"
            exit 1
            ;;
    esac
}

main "$@"
