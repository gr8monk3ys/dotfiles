#!/usr/bin/env bash
# dotfiles-why - Explain why a tool is part of these dotfiles.
#
# Usage:
#   dotfiles-why              Interactive fzf browser over every package
#   dotfiles-why <tool>       Print why <tool> is here (package or command name)
#   dotfiles-why --list       List every package, one per line
#
# The rationale lives on each package's manifest line (install/README.md
# § Entry format) and is read through bin/manifest, like every other question
# about what this system installs. A command works as well as a package name:
# `dotfiles-why rg` finds ripgrep.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"
MANIFEST="$SCRIPT_DIR/manifest"

list_tools() {
    "$MANIFEST" entries | cut -f2 | awk '!seen[$0]++' | sort
}

# Print one package or command: one block per distinct package matched (a
# command can match two, e.g. `jj` is both brew "jj" and pacman "jujutsu"),
# gathering every manifest line of each — `rg` matches only the Brewfile's
# ripgrep line, but ripgrep is in the pacmanfile too.
show_tool() {
    local names
    names="$("$MANIFEST" describe "$1" | cut -f2 | tr '\n' ' ')" || return 1
    "$MANIFEST" entries | awk -F'\t' -v dir="$DOTFILES_DIR" -v names="$names" '
        BEGIN { split(names, list, " "); for (i in list) want[list[i]] = 1 }
        !($2 in want) { next }
        !($2 in kinds) { order[++n] = $2 }
        {
            kinds[$2] = kinds[$2] (kinds[$2] == "" ? "" : ", ") $1
            if ($3 != $2) cmd[$2] = $3
            if ($4 != "") tier[$2] = $4
            if ($5 != "" && why[$2] == "") why[$2] = $5
        }
        END {
            for (i = 1; i <= n; i++) {
                p = order[i]
                if (i > 1) print ""
                print "### " p
                print ""
                print (why[p] != "" ? why[p] : "(no rationale recorded)")
                print ""
                print "- **Installed via:** " kinds[p]
                if (p in cmd) print "- **Command:** `" cmd[p] "`"
                if (p in tier) print "- **Doctor tier:** " tier[p]
                # A config directory is derived, not recorded: whichever of
                # the package or command names one the checkout ships.
                for (j = 0; j < 2; j++) {
                    name = (j == 0 ? p : ((p in cmd) ? cmd[p] : ""))
                    if (name == "") continue
                    if (system("test -d \"" dir "/.config/" name "\"") == 0) {
                        print "- **Config:** `.config/" name "/`"
                        break
                    }
                }
            }
        }'
}

render() {
    if command -v bat > /dev/null 2>&1; then
        bat --language=markdown --style=plain --color=auto --paging=never
    else
        cat
    fi
}

case "${1:-}" in
    -h | --help)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    --list)
        list_tools
        ;;
    --show)
        # Internal: used as the fzf preview command.
        show_tool "${2:?--show requires a tool name}" | render
        ;;
    "")
        # The fzf browser needs a terminal on both ends; without one it would
        # hang waiting for input (e.g. when run from a script or with </dev/null).
        if [[ ! -t 0 || ! -t 1 ]]; then
            echo "Usage: dotfiles-why <tool> | dotfiles-why --list" >&2
            echo "(interactive browser requires a terminal)" >&2
            exit 1
        fi
        if ! command -v fzf > /dev/null 2>&1; then
            echo "fzf not found — run 'dotfiles-why --list' or 'dotfiles-why <tool>'" >&2
            exit 1
        fi
        selection="$(list_tools | fzf \
            --prompt='why ' \
            --header='Why is this tool in the dotfiles? (enter to print)' \
            --preview="'${BASH_SOURCE[0]}' --show {}" \
            --preview-window=right:65%:wrap)" || exit 0
        show_tool "$selection" | render
        ;;
    *)
        if ! entry="$(show_tool "$1")"; then
            echo "No manifest entry for '$1'." >&2
            echo "Closest matches:" >&2
            list_tools | grep -i -- "$1" >&2 || echo "  (none)" >&2
            exit 1
        fi
        printf '%s\n' "$entry" | render
        ;;
esac
