#!/usr/bin/env bash
# dotfiles-doctor - Check system health and configuration status

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"
# shellcheck source=lib/ui.sh
source "$SCRIPT_DIR/lib/ui.sh"
# shellcheck source=lib/git-sync.sh
source "$SCRIPT_DIR/lib/git-sync.sh"

# Resolved once: bin/platform is an executable (the Makefile cannot source
# it), so cache the answer rather than forking per branch. Resolved from this
# script's own directory, not DOTFILES_DIR: DOTFILES_DIR is the checkout being
# inspected, which may be a fixture with no bin/.
PLATFORM="$SCRIPT_DIR/platform"
PLATFORM_OS="$("$PLATFORM" detect)"
readonly PLATFORM PLATFORM_OS

# Track overall health
ISSUES=0
WARNINGS=0

# The commands this health check probes, by severity. These are *command*
# names, not package names: `rg` ships in the `ripgrep` package. The mapping
# and the exemptions live in test/allowlist/command-packages.txt, and
# bin/validate-doctor-tools fails when these lists and the install manifests
# drift apart in either direction.
readonly DOCTOR_CORE_TOOLS=("git" "zsh" "nvim" "stow")
readonly DOCTOR_ESSENTIAL_TOOLS=("eza" "bat" "fd" "rg" "zoxide" "fzf")
readonly DOCTOR_NEXTGEN_TOOLS=("yazi" "zellij" "jj" "delta" "atuin")
readonly DOCTOR_ADDITIONAL_TOOLS=("navi" "broot" "tldr" "gping" "ouch")

# Every probed command, one per line. Consumed by bin/validate-doctor-tools.
list_checked_tools() {
    printf '%s\n' \
        "${DOCTOR_CORE_TOOLS[@]}" \
        "${DOCTOR_ESSENTIAL_TOOLS[@]}" \
        "${DOCTOR_NEXTGEN_TOOLS[@]}" \
        "${DOCTOR_ADDITIONAL_TOOLS[@]}"
}

# Thin counters over lib/ui.sh's printers: the tally is doctor's own state,
# the formatting is not.
check_pass() {
    print_success "$1"
}

check_fail() {
    print_error "$1"
    ((++ISSUES))
}

check_warn() {
    print_warn "$1"
    ((++WARNINGS))
}

check_info() {
    print_info "$1"
}

# Check System Information
check_system() {
    print_header "System Information"

    if [[ "$PLATFORM_OS" == "macos" ]]; then
        check_pass "Operating System: macOS $(sw_vers -productVersion)"

        # Check architecture
        if [[ "$("$PLATFORM" arch)" == "arm64" ]]; then
            check_pass "Architecture: Apple Silicon (ARM64)"
        else
            check_pass "Architecture: Intel (x86_64)"
        fi
    elif [[ "$PLATFORM_OS" == "arch" || "$PLATFORM_OS" == "linux" ]]; then
        check_pass "Operating System: Linux"
        local distro="Unknown"
        if [[ -r /etc/os-release ]]; then
            distro="$(. /etc/os-release && echo "${PRETTY_NAME:-${NAME:-Unknown}}")"
        fi
        check_info "Distribution: $distro"
        if "$PLATFORM" is-omarchy; then
            check_info "Omarchy detected (~/.local/share/omarchy) — see OPERATING.md § Omarchy"
        fi
    else
        # The module answers the question; the raw value stays as detail,
        # because "unknown" alone is useless in a bug report.
        check_warn "Operating System: $OSTYPE (Limited support)"
    fi

    check_info "Shell: $SHELL"
    check_info "User: ${USER:-$(id -un)}"
    check_info "Home: $HOME"
}

# Check dotfiles repository
check_dotfiles() {
    print_header "Dotfiles Repository"

    if [[ -d "$DOTFILES_DIR" ]]; then
        check_pass "Dotfiles directory found: $DOTFILES_DIR"

        cd "$DOTFILES_DIR"

        # Check if it's a git repository
        if [[ -d ".git" ]]; then
            check_pass "Git repository initialized"

            # Check for uncommitted changes
            if [[ -n $(git status --porcelain) ]]; then
                check_warn "Uncommitted changes detected"
            else
                check_pass "Repository is clean"
            fi

            # Check remote
            if git remote -v | grep -q origin; then
                check_pass "Remote origin configured"
            else
                check_warn "No remote origin configured"
            fi

            # Sync state, offline: compares against the last fetch rather than
            # contacting the remote, so `doctor` stays fast and works on a
            # plane. Same module dotfiles-update and dotfiles-sync act on.
            git_sync_status "$DOTFILES_DIR" no-fetch
            case "$GIT_SYNC_STATE" in
                "$GIT_SYNC_CLEAN_BEHIND")
                    check_warn "Behind origin by $GIT_SYNC_BEHIND commit(s) as of last fetch (run 'dotfiles-update')"
                    ;;
                "$GIT_SYNC_DIVERGED")
                    check_warn "Local and remote have diverged - manual merge required"
                    ;;
                "$GIT_SYNC_NO_UPSTREAM")
                    check_warn "No upstream configured - this checkout can never sync"
                    ;;
            esac
        else
            check_warn "Not a git repository"
        fi
    else
        check_fail "Dotfiles directory not found: $DOTFILES_DIR"
    fi
}

# Check symlinks
#
# A reporter over bin/link-state: the classification lives there, where it is
# tested directly. This used to carry its own folded/unfolded logic plus a
# hand-written list of 8 directories, while stow links all 26 the checkout
# ships — so 18 were never judged at all.
check_symlinks() {
    print_header "Symlink Status"

    if [[ ! -d "$HOME/.config" ]]; then
        check_fail ".config directory not found"
        return 0
    fi
    check_pass ".config directory exists"

    local state path rel
    while IFS=$'\t' read -r state path; do
        rel="${path#"$HOME"/}"
        case "$state" in
            linked)
                check_pass "$rel linked"
                ;;
            partial)
                check_fail "$rel: some files not linked into $DOTFILES_DIR (run 'make link')"
                ;;
            unlinked)
                check_fail "$rel not linked (run 'make link')"
                ;;
            unmanaged)
                check_warn "$rel exists but is not linked into $DOTFILES_DIR"
                ;;
            broken-ours)
                check_fail "$rel is a broken link into $DOTFILES_DIR (run 'make clean')"
                ;;
            broken-foreign)
                # Someone else's broken link; not ours to judge.
                ;;
        esac
    done < <("$SCRIPT_DIR/link-state")
}

# Check package managers
check_package_managers() {
    print_header "Package Managers"

    # Homebrew
    if command_exists brew; then
        check_pass "Homebrew installed ($(brew --version | head -n1))"

        # Check for outdated packages
        # No auto-update: a bare `brew outdated` first refreshes every tap (>60s)
        outdated=$(HOMEBREW_NO_AUTO_UPDATE=1 brew outdated | wc -l | tr -d ' ')
        if [[ "$outdated" -gt 0 ]]; then
            check_warn "$outdated Homebrew packages need updating"
        else
            check_pass "All Homebrew packages up to date"
        fi
    else
        if [[ "$PLATFORM_OS" == "macos" ]]; then
            check_fail "Homebrew not installed"
        else
            check_info "Homebrew not installed (macOS only)"
        fi
    fi

    # npm
    if command_exists npm; then
        check_pass "npm installed ($(npm --version))"
    else
        check_warn "npm not installed"
    fi

    # Cargo
    if command_exists cargo; then
        check_pass "Cargo installed ($(cargo --version | cut -d' ' -f2))"
    else
        check_warn "Cargo not installed"
    fi

    # pacman: the repo ships a bin/pacman sudo wrapper that satisfies a bare
    # command_exists on any OS via make's PATH, so only count a real one.
    local pacman_bin
    pacman_bin="$(command -v pacman 2>/dev/null || true)"
    if [[ -n "$pacman_bin" && "$pacman_bin" != "$DOTFILES_DIR/bin/pacman" && -f /etc/arch-release ]]; then
        check_pass "pacman installed"
    fi
}

# Check core tools. Missing tools are warnings, not issues: `make link`
# installs nothing, so a freshly linked box must still be able to pass.
check_core_tools() {
    print_header "Core Tools"

    for tool in "${DOCTOR_CORE_TOOLS[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool installed"
        else
            check_warn "$tool not installed"
        fi
    done
}

# Check modern CLI tools
check_modern_tools() {
    print_header "Modern CLI Tools"

    # Essential modern tools
    for tool in "${DOCTOR_ESSENTIAL_TOOLS[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool installed"
        else
            check_warn "$tool not installed (recommended)"
        fi
    done

    # Next-gen tools (optional but nice to have)
    for tool in "${DOCTOR_NEXTGEN_TOOLS[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool installed"
        else
            check_info "$tool not installed (optional)"
        fi
    done

    # Additional modern tools
    for tool in "${DOCTOR_ADDITIONAL_TOOLS[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool installed"
        else
            check_info "$tool not installed (optional)"
        fi
    done
}

# Check shell configuration
check_shell_config() {
    print_header "Shell Configuration"

    # Check if zsh is the login shell. Prefer the passwd entry over $SHELL:
    # a terminal launched with `command = zsh` sets neither.
    local login_shell
    login_shell="$(getent passwd "${USER:-$(id -un)}" 2>/dev/null | cut -d: -f7 || true)"
    login_shell="${login_shell:-$SHELL}"
    if [[ "$login_shell" == *"zsh"* ]]; then
        check_pass "Zsh is login shell"
    elif "$PLATFORM" is-omarchy; then
        # Omarchy ships bash as login shell and its boot chain (SDDM session,
        # ~/.bashrc, omarchy-* helpers) assumes it. Upstream advises against
        # chsh; point the terminal at zsh instead. Details in OPERATING.md.
        check_warn "Login shell is $login_shell, not zsh. On Omarchy set 'command = $(command -v zsh || echo /usr/bin/zsh)' in ~/.config/ghostty/config (upstream discourages chsh -s \$(which zsh))"
    else
        check_warn "Login shell is $login_shell, not zsh (run: chsh -s \$(which zsh))"
    fi

    # Check ZDOTDIR
    if [[ -n "${ZDOTDIR:-}" ]]; then
        check_pass "ZDOTDIR set: $ZDOTDIR"
    else
        check_warn "ZDOTDIR not set"
    fi

    # Check Zinit (plugin manager used by .zshrc; it self-installs on first run)
    if [[ -d "${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git" ]]; then
        check_pass "Zinit installed"
    else
        check_warn "Zinit not installed (will bootstrap on next zsh start)"
    fi
}

# Octal mode of a path. BSD stat is `-f FORMAT`; on GNU `-f` means
# "filesystem status" and succeeds, so an `||` fallback never fires.
file_mode() {
    "$PLATFORM" file-mode "$1"
}

# Check the gitignored local files: git identity, jj identity, SSH snippets.
#
# A reporter over bin/dotfiles-init (CONTEXT.md § Reporter), which is also what
# writes them — so the health check and the fix cannot disagree about what
# "configured" means. Doctor used to ask `git config --global user.email`
# itself and name the problem without being able to point at a fix.
#
# Warnings, never issues: `make link` installs nothing and configures nothing,
# so a freshly linked box must still be able to pass.
check_local_config() {
    print_header "Local Configuration"

    local state subject detail unconfigured=0
    while IFS=$'\t' read -r state subject detail; do
        case "$state" in
            configured)
                check_pass "$subject: $detail"
                ;;
            optional)
                check_info "$subject: $detail"
                ;;
            unconfigured | incomplete | ineffective)
                check_warn "$subject ($state): $detail"
                unconfigured=1
                ;;
        esac
    done < <("$SCRIPT_DIR/dotfiles-init" --status)

    [[ "$unconfigured" -eq 1 ]] && check_info "Run 'make init' (or 'dotfiles-init') to fix the above"
    return 0
}

# Check file permissions
check_permissions() {
    print_header "File Permissions"

    if [[ -d "$HOME/.ssh" ]]; then
        local ssh_perms
        ssh_perms=$(file_mode "$HOME/.ssh")
        if [[ "$ssh_perms" == "700" ]]; then
            check_pass ".ssh directory permissions: 700"
        else
            check_warn ".ssh directory permissions: $ssh_perms (should be 700)"
        fi
    fi

    # Check for private keys with wrong permissions
    if [[ -d "$HOME/.ssh" ]]; then
        while IFS= read -r key; do
            if [[ -f "$key" ]]; then
                local key_perms
                key_perms=$(file_mode "$key")
                if [[ "$key_perms" == "600" ]]; then
                    check_pass "$(basename "$key") permissions: 600"
                else
                    check_warn "$(basename "$key") permissions: $key_perms (should be 600)"
                fi
            fi
        done < <(find "$HOME/.ssh" -name "id_*" -not -name "*.pub" 2>/dev/null)
    fi
}

# Summary
print_summary() {
    print_header "Summary"

    echo ""
    if [[ $ISSUES -eq 0 && $WARNINGS -eq 0 ]]; then
        echo -e "${GREEN}✓ All checks passed! System is healthy.${NC}"
    else
        [[ $ISSUES -gt 0 ]] && echo -e "${RED}✗ $ISSUES issue(s) found${NC}"
        [[ $WARNINGS -gt 0 ]] && echo -e "${YELLOW}⚠ $WARNINGS warning(s) found${NC}"
    fi
    echo ""

    # Return non-zero if there are issues
    if [[ $ISSUES -gt 0 ]]; then
        return 1
    fi
    return 0
}

# Show help message
show_help() {
    cat << EOF
Usage: dotfiles-doctor [OPTIONS]

Comprehensive health check for dotfiles system and configurations.

OPTIONS:
    -h, --help      Show this help message
    -v, --verbose   Show verbose output (detailed checks)

DESCRIPTION:
    Checks system health including:
    - System information and platform
    - Dotfiles repository status
    - Symlink integrity
    - Package manager status
    - Core tool availability
    - Shell configuration
    - Local configuration (git/jj identity, SSH host snippets)
    - File permissions

EXIT CODES:
    0    All checks passed
    1    Issues found

EXAMPLES:
    dotfiles-doctor              Run health check
    dotfiles-doctor --help       Show this help
    dotfiles-doctor --verbose    Run with detailed output
    dotfiles-doctor --list-checked-tools
                                 List the commands this check probes

EOF
}

# Main
main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                set -x
                shift
                ;;
            --list-checked-tools)
                list_checked_tools
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done

    echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║                  Dotfiles Health Check                        ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"

    check_system
    check_dotfiles
    check_symlinks
    check_package_managers
    check_core_tools
    check_modern_tools
    check_shell_config
    check_local_config
    check_permissions
    print_summary
}

main "$@"
