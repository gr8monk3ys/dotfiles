# Generated by bin/rice-themes from .config/palette/templates/delta.gitconfig
# for the danse rice. Edit the template, then `bin/rice-themes render`.
#
# A delta feature, included from .config/git/config. .config/zsh/rice.zsh
# sets DELTA_FEATURES=rice-<rice>, which picks one of these per shell.
[delta "rice-danse"]
	syntax-theme = danse
	plus-style = "syntax #2d3b2d"
	plus-emph-style = "syntax #98c379"
	minus-style = "syntax #3b2d2d"
	minus-emph-style = "syntax #e06a51"
	line-numbers-minus-style = "#e06a51"
	line-numbers-plus-style = "#98c379"
	line-numbers-zero-style = "#5c6370"
	hunk-header-decoration-style = "#61afef box"
	file-style = "bold #61afef"
