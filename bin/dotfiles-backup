#!/usr/bin/env bash
# dotfiles-backup - Backup current configurations and packages

set -euo pipefail

readonly BACKUP_DIR="${BACKUP_DIR:-$HOME/dotfiles-backup}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
readonly TIMESTAMP
readonly BACKUP_PATH="$BACKUP_DIR/$TIMESTAMP"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"
# shellcheck source=lib/ui.sh
source "$SCRIPT_DIR/lib/ui.sh"
# shellcheck source=lib/snapshot.sh
source "$SCRIPT_DIR/lib/snapshot.sh"

# Setup backup directory
setup_backup_dir() {
    print_header "Setting Up Backup"

    print_info "Creating backup directory: $BACKUP_PATH"
    mkdir -p "$BACKUP_PATH"
    print_success "Backup directory created"
}

# Backup Homebrew packages
backup_homebrew() {
    print_header "Backing Up Homebrew Packages"

    if ! command_exists brew; then
        print_info "Homebrew not installed, skipping..."
        return 0
    fi

    print_info "Backing up Homebrew formulae..."
    brew bundle dump --force --file="$BACKUP_PATH/Brewfile"
    snapshot_provenance "$BACKUP_PATH/Brewfile" "brew bundle dump"
    print_success "Brewfile saved"

    print_info "Backing up Homebrew casks..."
    brew bundle dump --force --file="$BACKUP_PATH/Caskfile" --cask
    snapshot_provenance "$BACKUP_PATH/Caskfile" "brew bundle dump --cask"
    print_success "Caskfile saved"
}

# Backup npm packages
backup_npm() {
    print_header "Backing Up npm Packages"

    if ! command_exists npm; then
        print_info "npm not installed, skipping..."
        return 0
    fi

    # Named npm-global-list.txt, not npmfile.txt: this is `npm list` tree
    # output, not the bare-name format of install/npmfile.
    print_info "Backing up global npm packages..."
    npm list -g --depth=0 > "$BACKUP_PATH/npm-global-list.txt"
    snapshot_provenance "$BACKUP_PATH/npm-global-list.txt" "npm list -g --depth=0"
    print_success "npm packages saved"
}

# Backup Cargo packages
backup_cargo() {
    print_header "Backing Up Cargo Packages"

    if ! command_exists cargo; then
        print_info "Cargo not installed, skipping..."
        return 0
    fi

    # Named cargo-installed.txt, not Rustfile.txt: this is
    # `cargo install --list` output, not the format of install/Rustfile.
    print_info "Backing up cargo packages..."
    cargo install --list > "$BACKUP_PATH/cargo-installed.txt"
    snapshot_provenance "$BACKUP_PATH/cargo-installed.txt" "cargo install --list"
    print_success "Cargo packages saved"
}

# Backup VSCode extensions
backup_vscode() {
    print_header "Backing Up VSCode Extensions"

    # Both, when both exist. A backup has no reason to choose an editor;
    # the installer's preference is a separate decision that lives in the
    # Makefile.
    local found=0

    if command_exists code; then
        print_info "Backing up VSCode extensions..."
        code --list-extensions > "$BACKUP_PATH/vscode-extensions.txt"
        snapshot_provenance "$BACKUP_PATH/vscode-extensions.txt" "code --list-extensions"
        print_success "VSCode extensions saved"
        found=1
    fi

    if command_exists codium; then
        print_info "Backing up VSCodium extensions..."
        codium --list-extensions > "$BACKUP_PATH/vscodium-extensions.txt"
        snapshot_provenance "$BACKUP_PATH/vscodium-extensions.txt" "codium --list-extensions"
        print_success "VSCodium extensions saved"
        found=1
    fi

    if [[ "$found" -eq 0 ]]; then
        print_info "VSCode/VSCodium not installed, skipping..."
    fi
}

# Backup important configs (if not symlinked)
backup_configs() {
    print_header "Backing Up Configurations"

    local config_backup="$BACKUP_PATH/configs"
    mkdir -p "$config_backup"

    # List of configs to backup (only if they exist and are NOT symlinks)
    local configs=(
        ".zshrc"
        ".zshenv"
        ".bashrc"
        ".bash_profile"
        ".vimrc"
        ".gitconfig"
        ".tmux.conf"
    )

    local backed_up=0
    for config in "${configs[@]}"; do
        if [[ -f "$HOME/$config" ]] && [[ ! -L "$HOME/$config" ]]; then
            cp "$HOME/$config" "$config_backup/"
            print_success "Backed up $config"
            ((++backed_up))
        fi
    done

    if [[ $backed_up -eq 0 ]]; then
        print_info "No non-symlinked configs found to backup"
    else
        print_success "Backed up $backed_up configuration files"
    fi
}

# Backup SSH keys (safely)
backup_ssh() {
    print_header "Backing Up SSH Configuration"

    if [[ ! -d "$HOME/.ssh" ]]; then
        print_info ".ssh directory not found, skipping..."
        return 0
    fi

    local ssh_backup="$BACKUP_PATH/ssh"
    mkdir -p "$ssh_backup"

    # Only backup config and known_hosts (NOT private keys for security)
    if [[ -f "$HOME/.ssh/config" ]]; then
        cp "$HOME/.ssh/config" "$ssh_backup/"
        print_success "SSH config backed up"
    fi

    if [[ -f "$HOME/.ssh/known_hosts" ]]; then
        cp "$HOME/.ssh/known_hosts" "$ssh_backup/"
        print_success "SSH known_hosts backed up"
    fi

    print_info "Note: Private keys are NOT backed up for security"
}

# Create backup manifest
create_manifest() {
    print_header "Creating Backup Manifest"

    local manifest="$BACKUP_PATH/MANIFEST.txt"

    cat > "$manifest" << EOF
Dotfiles Backup Manifest
========================

Backup Date: $(date)
Hostname: $(hostname)
User: ${USER:-$(id -un)}
OS: $(uname -s)

Backup Contents:
EOF

    # List all backed up files
    {
        echo ""
        echo "Files:"
        find "$BACKUP_PATH" -type f | sed "s|$BACKUP_PATH/||" | sort
    } >> "$manifest"

    # Add system info
    if "$SCRIPT_DIR/platform" is-macos; then
        echo "" >> "$manifest"
        echo "macOS Version: $(sw_vers -productVersion)" >> "$manifest"
    fi

    # Record line counts for every record artifact that was written, driven
    # by the snapshot table so a new artifact is counted without editing here.
    {
        echo ""
        echo "Records:"
        local name path lines
        while IFS= read -r name; do
            path="$(snapshot_present "$BACKUP_PATH" "$name")" || continue
            lines=$(grep -cv '^[[:space:]]*\(#\|$\)' "$path" || true)
            printf '  %-26s %s line(s)  %s\n' "$name" "${lines:-0}" "$(snapshot_description "$name")"
        done < <(snapshot_names_of_class record)
    } >> "$manifest"

    print_success "Manifest created"
}

# Compress backup (optional)
compress_backup() {
    print_header "Compressing Backup"

    local archive="$BACKUP_DIR/backup_$TIMESTAMP.tar.gz"

    print_info "Creating compressed archive..."
    tar -czf "$archive" -C "$BACKUP_DIR" "$TIMESTAMP"

    if [[ -f "$archive" ]]; then
        print_success "Backup compressed: $archive"
        print_info "Original backup kept at: $BACKUP_PATH"

        # Calculate sizes
        local orig_size
        orig_size=$(du -sh "$BACKUP_PATH" | cut -f1)
        local comp_size
        comp_size=$(du -sh "$archive" | cut -f1)
        print_info "Original size: $orig_size"
        print_info "Compressed size: $comp_size"
    fi
}

# Generate summary
generate_summary() {
    print_header "Backup Summary"

    echo ""
    print_success "Backup completed successfully!"
    echo ""
    print_info "Backup location: $BACKUP_PATH"
    print_info "View manifest: cat $BACKUP_PATH/MANIFEST.txt"
    echo ""
    print_info "To restore from this backup, see OPERATING.md"
    echo ""

    # Driven by the snapshot table: adding an artifact there lists it here.
    local name class
    echo "Restorable by dotfiles-restore:"
    while IFS= read -r name; do
        snapshot_present "$BACKUP_PATH" "$name" > /dev/null &&
            echo "  • $name — $(snapshot_description "$name")"
    done < <(snapshot_names_of_class tree)

    echo ""
    echo "Preserved for reference (not replayed):"
    while IFS= read -r name; do
        snapshot_present "$BACKUP_PATH" "$name" > /dev/null &&
            echo "  • $name — $(snapshot_description "$name")"
    done < <(snapshot_names_of_class record)
    echo ""
}

# Cleanup old backups
cleanup_old_backups() {
    local keep_count=${1:-5}
    local backups=()
    local backup
    local backup_count
    local remove_count
    local i

    print_header "Cleaning Up Old Backups"

    while IFS= read -r backup; do
        backups+=("$backup")
    done < <(find "$BACKUP_DIR" -maxdepth 1 -type d -name "20*" | sort)

    backup_count=${#backups[@]}

    if [[ $backup_count -gt $keep_count ]]; then
        print_info "Found $backup_count backups, keeping latest $keep_count"
        remove_count=$((backup_count - keep_count))

        # Remove oldest backups, and the archive --compress made from each:
        # cleanup used to remove only directories, so archives accumulated
        # unbounded and nothing ever read them.
        for ((i = 0; i < remove_count; i++)); do
            rm -rf "${backups[$i]}"
            rm -f "$BACKUP_DIR/backup_$(basename "${backups[$i]}").tar.gz"
        done

        print_success "Old backups removed"
    else
        print_info "Only $backup_count backups found, no cleanup needed"
    fi
}

# Main
main() {
    echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║                   Dotfiles Backup Tool                        ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"

    # Parse arguments
    local compress=false
    local cleanup=false

    while [[ $# -gt 0 ]]; do
        case $1 in
            -c|--compress)
                compress=true
                shift
                ;;
            -C|--cleanup)
                cleanup=true
                shift
                ;;
            -h|--help)
                echo "Usage: dotfiles-backup [OPTIONS]"
                echo ""
                echo "Options:"
                echo "  -c, --compress    Compress backup after creation"
                echo "  -C, --cleanup     Remove old backups (keep latest 5)"
                echo "  -h, --help        Show this help message"
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    # Perform backup
    setup_backup_dir
    backup_homebrew
    backup_npm
    backup_cargo
    backup_vscode
    backup_configs
    backup_ssh
    create_manifest

    # Optional operations
    if [[ "$compress" = true ]]; then
        compress_backup
    fi

    if [[ "$cleanup" = true ]]; then
        cleanup_old_backups 5
    fi

    # Show summary
    generate_summary
}

main "$@"
