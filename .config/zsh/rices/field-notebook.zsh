# Generated by bin/rice-themes from .config/palette/templates/zsh.zsh
# for the field-notebook rice. Edit the template, then `bin/rice-themes render`.
#
# The shell's own colours. Sourced by .config/zsh/rice.zsh, after the
# plugins are loaded: zsh-syntax-highlighting and zsh-autosuggestions read
# these at draw time, and .zshrc folds DOTFILES_FZF_COLORS into
# FZF_DEFAULT_OPTS (fzf-tab, ctrl-r/ctrl-t and fzf-based scripts inherit it).

# Valid commands in the success colour, errors in the error colour, paths
# underlined in the accent.
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#42a979'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#42a979'
ZSH_HIGHLIGHT_STYLES[function]='fg=#42a979'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#42a979'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#42a979,italic'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#b796c8'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#e87c7c'
ZSH_HIGHLIGHT_STYLES[path]='fg=#7aa0e6,underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#5fb3a1'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#e3b25e'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#e3b25e'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#e08d55'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#767c87,italic'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#b796c8'

# The ghost text after the cursor: the comment colour, like a code comment.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#767c87'

# fzf; bg:-1 keeps the terminal's own background so the glass shows through.
DOTFILES_FZF_COLORS='--color=bg:-1,fg:#eceef1,hl:#7aa0e6 --color=bg+:#292c32,fg+:#eceef1,hl+:#7aa0e6 --color=prompt:#42a979,pointer:#b796c8,marker:#42a979 --color=info:#e3b25e,spinner:#5fb3a1,header:#5fb3a1,border:#767c87'

# eza: EZA_COLORS is what every eza build honours (Homebrew's ignores
# theme.yml), so the theme is expressed here too, as SGR truecolor triples.
# Keys: di=dir ln=symlink ex=executable pi=pipe so=socket bd/cd=devices
#       fi=file u*=permission bits g*=git status da=date uu/gu=user/group
export EZA_COLORS="di=38;2;122;160;230:ln=38;2;95;179;161:ex=38;2;66;169;121:pi=38;2;227;178;94:so=38;2;183;150;200:bd=38;2;227;178;94:cd=38;2;227;178;94:fi=38;2;236;238;241:ur=38;2;227;178;94:uw=38;2;232;124;124:ux=38;2;66;169;121:gm=38;2;66;169;121:ga=38;2;227;178;94:gd=38;2;232;124;124:da=38;2;118;124;135:uu=38;2;236;238;241:gu=38;2;118;124;135"
