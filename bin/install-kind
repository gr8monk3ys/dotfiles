#!/usr/bin/env bash
# install-kind - Install one manifest kind.
#
# How a kind is installed — which manifest, which command, whether to skip,
# whether a failure is fatal — used to be re-derived in six Makefile targets,
# which is why the only way to test any of it was to grep `make -n` output.
# This module owns that; the Makefile keeps the dependency edges between
# kinds, which is the thing make is actually good at.
#
# Usage:
#   install-kind <kind>
#
# Kinds come from `bin/manifest kinds`: brew cask cask-extra npm rust pacman code
#
# Environment:
#   SKIP_KINDS        Space-separated kinds to skip, e.g. SKIP_KINDS="rust pacman"
#   STRICT_PACKAGES   1/true makes a package failure fatal. Unset, 0 or false
#                     (default), failures are tolerated and reported; `make
#                     doctor` is how you find out what is missing.
#
# A missing tool is not a failed install: `install-kind rust` on a machine
# with no cargo warns and exits 0. A kind that does not apply to this machine
# is not an error.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/preamble.sh
source "$SCRIPT_DIR/lib/preamble.sh"
# shellcheck source=lib/ui.sh
source "$SCRIPT_DIR/lib/ui.sh"

readonly MANIFEST="$SCRIPT_DIR/manifest"
readonly INSTALL_DIR="$DOTFILES_DIR/install"

SKIP_KINDS="${SKIP_KINDS:-}"

# --- policy ----------------------------------------------------------------

should_skip() {
    local kind="$1" entry
    for entry in $SKIP_KINDS; do
        [[ "$entry" == "$kind" ]] && return 0
    done
    return 1
}

# Run an install command under the strictness policy. Tolerant by default so
# one unavailable package does not abort a fresh machine's whole setup.
run_install() {
    if knob_on STRICT_PACKAGES; then
        "$@"
    else
        "$@" || print_warn "Continuing after failure (set STRICT_PACKAGES=1 to make this fatal)"
    fi
}

# Homebrew >= 5 refuses to install from third-party taps until they are
# trusted ("Refusing to load cask … from untrusted tap"). This is a step
# within installing a brew kind, not ordering between kinds, so it lives here
# rather than in a separate make target.
trust_taps() {
    brew help trust > /dev/null 2>&1 || return 0
    local tap
    while IFS= read -r tap; do
        brew trust "$tap" > /dev/null 2>&1 || brew trust "$tap" || true
    done < <("$MANIFEST" taps)
}

brew_bundle() {
    local file="$1"
    if ! command_exists brew; then
        print_warn "Homebrew not installed; skipping"
        return 0
    fi
    trust_taps
    run_install brew bundle --file="$INSTALL_DIR/$file"
}

# --- per-kind installers ---------------------------------------------------

install_brew() { brew_bundle Brewfile; }
install_cask() { brew_bundle Caskfile; }
install_cask_extra() { brew_bundle Caskfile.extra; }

install_npm() {
    if ! command_exists npm; then
        print_warn "npm not installed; skipping"
        return 0
    fi
    run_install sh -c "\"$MANIFEST\" list npm | xargs npm install --force --location global"
}

install_rust() {
    # rustup bootstrap is a real install step, not a guard.
    local rustup_prefix
    rustup_prefix="$(brew --prefix rustup 2> /dev/null || true)"
    export PATH="$HOME/.cargo/bin:$rustup_prefix/bin:$PATH"
    command_exists cargo || rustup default stable
    if ! command_exists cargo; then
        print_warn "cargo not installed; skipping"
        return 0
    fi
    run_install sh -c "\"$MANIFEST\" list rust | xargs -n1 cargo install"
}

install_pacman() {
    if ! command_exists pacman; then
        print_warn "pacman not installed; skipping"
        return 0
    fi
    # Was `pacman -S - < install/pacmanfile`, which fed comments straight to
    # pacman; it worked only because that file happens to have none.
    run_install sh -c "\"$MANIFEST\" list pacman | pacman -S --noconfirm -"
}

install_code() {
    # Two adapters, one interface. Prefers codium, matching what the Makefile
    # did; dotfiles-backup captures both because a backup has no reason to
    # choose, but an installer does.
    local editor=""
    if command_exists codium; then
        editor=codium
    elif command_exists code; then
        editor=code
    else
        print_warn "Neither codium nor code installed; skipping extensions"
        return 0
    fi

    print_info "Installing extensions with $editor..."
    local ext
    while IFS= read -r ext; do
        "$editor" --install-extension "$ext" || true
    done < <("$MANIFEST" list code)
}

# --- main ------------------------------------------------------------------

main() {
    local kind="${1:-}"

    if [[ -z "$kind" || "$kind" == "-h" || "$kind" == "--help" ]]; then
        sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
        [[ -z "$kind" ]] && return 2
        return 0
    fi

    # Deliberately not `"$MANIFEST" kinds | grep -Fxq`: grep -q exits on the
    # first match, SIGPIPEs the producer, and `set -o pipefail` then reports
    # the pipeline as failed — so a valid kind read as unknown unless it
    # happened to be the last one listed.
    local known
    known="$("$MANIFEST" kinds)"
    if ! printf '%s\n' "$known" | grep -Fxq -- "$kind"; then
        print_error "Unknown kind '$kind' (one of: $(printf '%s' "$known" | tr '\n' ' '))"
        return 2
    fi

    if should_skip "$kind"; then
        print_info "Skipping $kind (SKIP_KINDS)"
        return 0
    fi

    case "$kind" in
        brew) install_brew ;;
        cask) install_cask ;;
        cask-extra) install_cask_extra ;;
        npm) install_npm ;;
        rust) install_rust ;;
        pacman) install_pacman ;;
        code) install_code ;;
    esac
}

main "$@"
