#!/usr/bin/env bash
# dotfiles-restore - Restore files from dotfiles-backup snapshots.

set -euo pipefail

readonly SCRIPT_NAME="dotfiles-restore"
readonly BACKUP_DIR="${BACKUP_DIR:-$HOME/dotfiles-backup}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/ui.sh
source "$SCRIPT_DIR/lib/ui.sh"
# shellcheck source=lib/snapshot.sh
source "$SCRIPT_DIR/lib/snapshot.sh"

usage() {
    cat << EOF
Usage: $SCRIPT_NAME [BACKUP_PATH] [OPTIONS]

Restore files from a dotfiles backup created by dotfiles-backup.

A snapshot is a forensic record, not a replayable installer. Directory
artifacts (configs/, ssh/) are restored; package records (Brewfile,
npm-global-list.txt, ...) are preserved for reference and never replayed —
reinstalling packages is the job of make, from install/. Run with --dry-run
to see exactly which is which.

Arguments:
  BACKUP_PATH         Path to a specific backup directory (optional).
                      If omitted, latest backup under \$BACKUP_DIR is used.

Options:
  -f, --force         Overwrite existing files without creating pre-restore backups
  -n, --dry-run       Show what would be restored without changing files
  -l, --latest        Force restoring from latest backup in \$BACKUP_DIR
  -h, --help          Show this help message

Examples:
  $SCRIPT_NAME
  $SCRIPT_NAME --latest
  $SCRIPT_NAME ~/dotfiles-backup/20260224_120000
  $SCRIPT_NAME ~/dotfiles-backup/20260224_120000 --dry-run
EOF
}

die() {
    print_error "$*"
    exit 1
}

latest_backup_path() {
    [[ -d "$BACKUP_DIR" ]] || die "Backup directory not found: $BACKUP_DIR"
    local latest
    latest="$(find "$BACKUP_DIR" -maxdepth 1 -mindepth 1 -type d -name "20*" | sort | tail -n1)"
    [[ -n "$latest" ]] || die "No backups found in: $BACKUP_DIR"
    echo "$latest"
}

restore_tree() {
    local source_dir="$1"
    local target_root="$2"
    local force="$3"
    local dry_run="$4"
    local restored_ref="$5"

    [[ -d "$source_dir" ]] || return 0

    while IFS= read -r -d '' src; do
        local rel dest backup_copy
        rel="${src#"$source_dir"/}"
        dest="$target_root/$rel"
        mkdir -p "$(dirname "$dest")"

        if [[ -e "$dest" && "$force" != "true" ]]; then
            backup_copy="${dest}.pre-restore.$(date +%Y%m%d%H%M%S)"
            if [[ "$dry_run" == "true" ]]; then
                print_info "Would backup existing: $dest -> $backup_copy"
            else
                cp -a "$dest" "$backup_copy"
                print_info "Backed up existing: $dest -> $backup_copy"
            fi
        fi

        if [[ "$dry_run" == "true" ]]; then
            print_info "Would restore: $src -> $dest"
        else
            cp -a "$src" "$dest"
            print_success "Restored: $dest"
        fi

        eval "$restored_ref=\$(( $restored_ref + 1 ))"
    done < <(find "$source_dir" \( -type f -o -type l \) -print0)
}

main() {
    local backup_path=""
    local force="false"
    local dry_run="false"
    local use_latest="false"
    local restored=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force)
                force="true"
                shift
                ;;
            -n|--dry-run)
                dry_run="true"
                shift
                ;;
            -l|--latest)
                use_latest="true"
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                if [[ -n "$backup_path" ]]; then
                    die "Multiple backup paths provided. Use one path only."
                fi
                backup_path="$1"
                shift
                ;;
        esac
    done

    if [[ "$use_latest" == "true" || -z "$backup_path" ]]; then
        backup_path="$(latest_backup_path)"
    fi

    [[ -d "$backup_path" ]] || die "Backup path not found: $backup_path"

    print_header "Dotfiles Restore"
    print_info "Source backup: $backup_path"
    print_info "Target HOME: $HOME"
    print_info "Mode: $([[ "$dry_run" == "true" ]] && echo "dry-run" || echo "apply")"

    # Restorable artifacts, driven by the snapshot table.
    local name path target
    while IFS= read -r name; do
        path="$(snapshot_present "$backup_path" "$name")" || continue
        case "$name" in
            ssh) target="$HOME/.ssh" ;;
            *) target="$HOME" ;;
        esac
        restore_tree "$path" "$target" "$force" "$dry_run" restored
    done < <(snapshot_names_of_class tree)

    if [[ "$restored" -eq 0 ]]; then
        print_warn "No restorable files found in backup."
    elif [[ "$dry_run" == "true" ]]; then
        print_success "Dry run complete. Files that would be restored: $restored"
    else
        print_success "Restore complete. Files restored: $restored"
    fi

    # Say plainly what was left alone, rather than walking past it in silence.
    local preserved=()
    while IFS= read -r name; do
        snapshot_present "$backup_path" "$name" > /dev/null && preserved+=("$name")
    done < <(snapshot_names_of_class record)

    if [[ "${#preserved[@]}" -gt 0 ]]; then
        print_info "Preserved, not replayed (reinstall with 'make' from install/):"
        for name in "${preserved[@]}"; do
            print_info "  $name - $(snapshot_description "$name")"
        done
    fi

    # An artifact the table does not know: warn, never abort. A restore is run
    # under pressure; an unexpected file is not a reason to stop.
    local entry base
    for entry in "$backup_path"/*; do
        [[ -e "$entry" ]] || continue
        base="$(basename "$entry")"
        snapshot_class "$base" > /dev/null 2>&1 ||
            print_warn "Present in backup but not restorable: $base"
    done
}

main "$@"
