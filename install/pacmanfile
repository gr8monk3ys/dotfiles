ca-certificates
dbus
gnupg
openssh                                # SSH client the `.config/ssh/` config is written for. macOS ships it; Arch does not install it by default.
curl                                   # HTTP client used by `install.sh` and assorted scripts. macOS ships it; Arch's `base` does not, so it is explicit here.
wget

# ============================================================================
# Shell
# The repo is built around zsh; without these `make arch` leaves a machine
# with no login shell config, no prompt and no symlink farm.
# ============================================================================
zsh                                    # Login shell; config split across `.zshenv` / `.config/zsh/`. macOS ships it, so only Arch lists it.
zsh-syntax-highlighting
bash-completion                        # Completions for bash sessions on Arch boxes.
starship
stow                                   # GNU Stow creates the symlink farm for all configs. `make link` bootstraps it on macOS; listed here so `make arch` installs it outright.

