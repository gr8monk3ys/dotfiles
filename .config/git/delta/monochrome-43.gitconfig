# Generated by bin/rice-themes from .config/palette/templates/delta.gitconfig
# for the monochrome-43 rice. Edit the template, then `bin/rice-themes render`.
#
# A delta feature, included from .config/git/config. .config/zsh/rice.zsh
# sets DELTA_FEATURES=rice-<rice>, which picks one of these per shell.
[delta "rice-monochrome-43"]
	syntax-theme = monochrome-43
	plus-style = "syntax #161616"
	plus-emph-style = "syntax #c2c2c2"
	minus-style = "syntax #2a2a2a"
	minus-emph-style = "syntax #ff003c"
	line-numbers-minus-style = "#ff003c"
	line-numbers-plus-style = "#c2c2c2"
	line-numbers-zero-style = "#6f6f6f"
	hunk-header-decoration-style = "#7aa2f7 box"
	file-style = "bold #7aa2f7"
