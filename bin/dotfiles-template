#!/usr/bin/env bash
#
# dotfiles-template - Simple template processor for dotfiles
#
# Usage: dotfiles-template [OPTIONS] <input.tmpl> [output]
#
# Processes template files and replaces variables with system-specific values.
# If output is not specified, writes to stdout.
#
# Available Variables:
#   {{HOSTNAME}}      - System hostname
#   {{OS}}            - Operating system (Darwin, Linux)
#   {{OS_TYPE}}       - OS type (macos, arch, linux)
#   {{ARCH}}          - Architecture (arm64, x86_64)
#   {{MACHINE_TYPE}}  - Machine profile (personal, work, server)
#   {{USER}}          - Current username
#   {{HOME}}          - Home directory
#   {{DOTFILES_DIR}}  - Dotfiles directory
#   {{DATE}}          - Current date (YYYY-MM-DD)
#
# Conditional Blocks:
#   {{#if OS_TYPE eq macos}}...{{/if}}
#   {{#if MACHINE_TYPE eq work}}...{{/if}}
#

set -euo pipefail

readonly VERSION="1.0.0"
SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

# Template variables
HOSTNAME="$(hostname -s 2>/dev/null || hostname)"
OS="$(uname -s)"
ARCH="$(uname -m)"
USER="${USER:-$(whoami)}"
HOME="${HOME:-/home/$USER}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
DATE="$(date +%Y-%m-%d)"

# Detect OS type
detect_os_type() {
    case "$OS" in
        Darwin)
            echo "macos"
            ;;
        Linux)
            if [[ -f /etc/arch-release ]]; then
                echo "arch"
            else
                echo "linux"
            fi
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

OS_TYPE="$(detect_os_type)"

# Get machine type from file or default to personal
get_machine_type() {
    local machine_file="$HOME/.machine_type"
    if [[ -f "$machine_file" ]]; then
        cat "$machine_file"
    else
        echo "personal"
    fi
}

MACHINE_TYPE="$(get_machine_type)"

# Show usage
usage() {
    cat << EOF
Usage: $SCRIPT_NAME [OPTIONS] <input.tmpl> [output]

Process template files with system-specific variables.

Options:
    -h, --help      Show this help message
    -v, --version   Show version
    -l, --list      List available variables
    -d, --dry-run   Show what would be replaced without writing

Examples:
    $SCRIPT_NAME config.tmpl config
    $SCRIPT_NAME gitconfig.tmpl ~/.gitconfig
    $SCRIPT_NAME --list
    cat template.tmpl | $SCRIPT_NAME -

EOF
}

# List available variables
list_variables() {
    cat << EOF
Available Template Variables:

  Variable          Current Value
  ─────────────────────────────────────────
  {{HOSTNAME}}      $HOSTNAME
  {{OS}}            $OS
  {{OS_TYPE}}       $OS_TYPE
  {{ARCH}}          $ARCH
  {{MACHINE_TYPE}}  $MACHINE_TYPE
  {{USER}}          $USER
  {{HOME}}          $HOME
  {{DOTFILES_DIR}}  $DOTFILES_DIR
  {{DATE}}          $DATE

Conditional Syntax:
  {{#if VAR eq value}}
  content shown if VAR equals value
  {{/if}}

  {{#if VAR neq value}}
  content shown if VAR does not equal value
  {{/if}}

EOF
}

# Process simple variable substitutions
substitute_variables() {
    local content="$1"

    content="${content//\{\{HOSTNAME\}\}/$HOSTNAME}"
    content="${content//\{\{OS\}\}/$OS}"
    content="${content//\{\{OS_TYPE\}\}/$OS_TYPE}"
    content="${content//\{\{ARCH\}\}/$ARCH}"
    content="${content//\{\{MACHINE_TYPE\}\}/$MACHINE_TYPE}"
    content="${content//\{\{USER\}\}/$USER}"
    content="${content//\{\{HOME\}\}/$HOME}"
    content="${content//\{\{DOTFILES_DIR\}\}/$DOTFILES_DIR}"
    content="${content//\{\{DATE\}\}/$DATE}"

    echo "$content"
}

# Process conditional blocks
# Supports: {{#if VAR eq value}}...{{/if}} and {{#if VAR neq value}}...{{/if}}
process_conditionals() {
    local content="$1"
    local result=""
    local in_block=false
    local show_block=false
    local block_content=""

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Check for start of conditional block
        if [[ "$line" =~ \{\{#if[[:space:]]+([A-Z_]+)[[:space:]]+(eq|neq)[[:space:]]+([a-z0-9_-]+)\}\} ]]; then
            in_block=true
            local var_name="${BASH_REMATCH[1]}"
            local operator="${BASH_REMATCH[2]}"
            local compare_value="${BASH_REMATCH[3]}"

            # Get variable value
            local var_value=""
            case "$var_name" in
                HOSTNAME) var_value="$HOSTNAME" ;;
                OS) var_value="$OS" ;;
                OS_TYPE) var_value="$OS_TYPE" ;;
                ARCH) var_value="$ARCH" ;;
                MACHINE_TYPE) var_value="$MACHINE_TYPE" ;;
                USER) var_value="$USER" ;;
                *) var_value="" ;;
            esac

            # Evaluate condition
            if [[ "$operator" == "eq" ]]; then
                [[ "$var_value" == "$compare_value" ]] && show_block=true || show_block=false
            else
                [[ "$var_value" != "$compare_value" ]] && show_block=true || show_block=false
            fi

            block_content=""
            continue
        fi

        # Check for end of conditional block
        if [[ "$line" =~ \{\{/if\}\} ]]; then
            if $show_block; then
                result+="$block_content"
            fi
            in_block=false
            show_block=false
            block_content=""
            continue
        fi

        # Accumulate content
        if $in_block; then
            block_content+="$line"$'\n'
        else
            result+="$line"$'\n'
        fi
    done <<< "$content"

    # Remove trailing newline
    echo "${result%$'\n'}"
}

# Process a template file
process_template() {
    local input="$1"
    local content

    if [[ "$input" == "-" ]]; then
        content="$(cat)"
    elif [[ -f "$input" ]]; then
        content="$(cat "$input")"
    else
        echo -e "${RED}Error:${NC} File not found: $input" >&2
        exit 1
    fi

    # Process conditionals first, then substitute variables
    content="$(process_conditionals "$content")"
    content="$(substitute_variables "$content")"

    echo "$content"
}

# Main function
main() {
    local dry_run=false
    local input=""
    local output=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            -v|--version)
                echo "$SCRIPT_NAME version $VERSION"
                exit 0
                ;;
            -l|--list)
                list_variables
                exit 0
                ;;
            -d|--dry-run)
                dry_run=true
                shift
                ;;
            -*)
                echo -e "${RED}Error:${NC} Unknown option: $1" >&2
                usage >&2
                exit 1
                ;;
            *)
                if [[ -z "$input" ]]; then
                    input="$1"
                elif [[ -z "$output" ]]; then
                    output="$1"
                else
                    echo -e "${RED}Error:${NC} Too many arguments" >&2
                    usage >&2
                    exit 1
                fi
                shift
                ;;
        esac
    done

    # Validate input
    if [[ -z "$input" ]]; then
        echo -e "${RED}Error:${NC} No input file specified" >&2
        usage >&2
        exit 1
    fi

    # Process template
    local result
    result="$(process_template "$input")"

    # Output result
    if $dry_run; then
        echo -e "${YELLOW}Dry run - would output:${NC}"
        echo "$result"
    elif [[ -z "$output" ]]; then
        echo "$result"
    else
        echo "$result" > "$output"
        echo -e "${GREEN}✓${NC} Processed $input -> $output"
    fi
}

main "$@"
