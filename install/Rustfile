# Development Tools
# ============================================================================

# ============================================================================
# Data Processing & Viewers
# ============================================================================
jless                                  # Pager for huge JSON files (jq/jnv handle querying; jless handles reading).

# ============================================================================
# Additional Rust Tools
# Note: Many of these are also available via Homebrew.
# Using Cargo ensures you get the latest versions.
# ============================================================================
# hyperfine                   # Benchmarking tool (prefer brew version)
# tokei                       # Code statistics tool (prefer brew version)
# bottom                      # System monitor btm (prefer brew version)
# du-dust                     # du replacement (prefer brew version)
# procs                       # ps replacement (prefer brew version)
# sd                          # sed alternative (prefer brew version)
# zoxide                      # Smarter cd command (prefer brew version)
# bat                         # Cat with highlighting (prefer brew version)
# eza                         # Modern ls replacement (prefer brew version)
# ripgrep                     # Fast grep (prefer brew version)
# fd-find                     # Fast find (prefer brew version)
