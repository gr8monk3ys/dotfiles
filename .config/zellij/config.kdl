// Zellij Configuration
// https://zellij.dev/documentation/configuration
// Modern terminal multiplexer as tmux alternative

// ============================================================================
// Theme (OneDark-inspired)
// ============================================================================
theme "custom"

themes {
    custom {
        fg "#abb2bf"
        bg "#282c34"
        black "#282c34"
        red "#e06c75"
        green "#98c379"
        yellow "#e5c07b"
        blue "#61afef"
        magenta "#c678dd"
        cyan "#56b6c2"
        white "#abb2bf"
        orange "#d19a66"
    }
}

// ============================================================================
// UI Settings
// ============================================================================
ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

// Show pane frames
pane_frames true

// Auto-layout (smart splitting)
auto_layout true

// Default shell
default_shell "zsh"

// Default layout
default_layout "compact"

// On attach to existing session
on_force_close "quit"

// Simplified UI (hide modes bar)
simplified_ui false

// Mouse support
mouse_mode true

// Scrollback
scroll_buffer_size 50000

// Copy on select
copy_on_select true

// Copy command (macOS)
copy_command "pbcopy"

// ============================================================================
// Keybindings
// ============================================================================
keybinds clear-defaults=true {
    // Normal mode
    normal {
        // Leader key: Ctrl+Space (like tmux)
        bind "Ctrl Space" { SwitchToMode "tmux"; }
    }

    // Tmux-like mode (after pressing Ctrl+Space)
    tmux {
        // Pane management
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }

        // Vim-style pane navigation
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }

        // Arrow key navigation
        bind "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }

        // Tab management
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }

        // Tab switching by number
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // Resize mode
        bind "H" { Resize "Increase Left"; }
        bind "J" { Resize "Increase Down"; }
        bind "K" { Resize "Increase Up"; }
        bind "L" { Resize "Increase Right"; }

        // Session management
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }

        // Scroll/Copy mode
        bind "[" { SwitchToMode "Scroll"; }

        // Rename tab
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }

        // Floating pane
        bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "F" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }

        // Sync panes (send to all)
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }

        // Exit mode
        bind "Esc" { SwitchToMode "Normal"; }
        bind "Ctrl Space" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }
    }

    // Scroll mode (for copy/search)
    scroll {
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "Esc" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "q" { ScrollToBottom; SwitchToMode "Normal"; }

        // Vim-like scrolling
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "Ctrl f" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }

        // Search
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }

        // Selection (for copy)
        bind "v" { SwitchToMode "EnterSearch"; }
    }

    // Search input mode
    entersearch {
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" { SwitchToMode "Scroll"; }
    }

    // Search mode
    search {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
    }

    // Tab rename mode
    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    // Shared (always active)
    shared_except "normal" {
        bind "Esc" { SwitchToMode "Normal"; }
    }
}

// ============================================================================
// Plugins
// ============================================================================
plugins {
    tab-bar { path "tab-bar"; }
    status-bar { path "status-bar"; }
    strider { path "strider"; }
    compact-bar { path "compact-bar"; }
    session-manager { path "session-manager"; }
}
