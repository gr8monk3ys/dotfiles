<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Service identifier -->
    <key>Label</key>
    <string>com.dotfiles.sync</string>

    <!-- Script to execute; __DOTFILES_DIR__ / __SYNC_LOG__ are filled in by `make sync-install` -->
    <key>ProgramArguments</key>
    <array>
        <string>__DOTFILES_DIR__/bin/dotfiles-sync</string>
    </array>

    <!-- launchd starts jobs with a bare PATH; make sure Homebrew git/gh are found -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Run daily at 10:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Persistent log (macOS purges /tmp); `make sync-status` tails it -->
    <key>StandardOutPath</key>
    <string>__SYNC_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__SYNC_LOG__</string>

    <!-- Don't run immediately when loaded, only at scheduled time -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
