# Generated by bin/rice-themes from .config/palette/templates/zsh.zsh
# for the {{rice}} rice. Edit the template, then `bin/rice-themes render`.
#
# The shell's own colours. Sourced by .config/zsh/rice.zsh, after the
# plugins are loaded: zsh-syntax-highlighting and zsh-autosuggestions read
# these at draw time, and .zshrc folds DOTFILES_FZF_COLORS into
# FZF_DEFAULT_OPTS (fzf-tab, ctrl-r/ctrl-t and fzf-based scripts inherit it).

# Valid commands in the success colour, errors in the error colour, paths
# underlined in the accent.
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg={{green}}'
ZSH_HIGHLIGHT_STYLES[builtin]='fg={{green}}'
ZSH_HIGHLIGHT_STYLES[function]='fg={{green}}'
ZSH_HIGHLIGHT_STYLES[alias]='fg={{green}}'
ZSH_HIGHLIGHT_STYLES[precommand]='fg={{green}},italic'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg={{magenta}}'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={{vermilion}}'
ZSH_HIGHLIGHT_STYLES[path]='fg={{blue}},underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg={{cyan}}'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg={{yellow}}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg={{yellow}}'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg={{terracotta}}'
ZSH_HIGHLIGHT_STYLES[comment]='fg={{comment}},italic'
ZSH_HIGHLIGHT_STYLES[redirection]='fg={{magenta}}'

# The ghost text after the cursor: the comment colour, like a code comment.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{comment}}'

# fzf; bg:-1 keeps the terminal's own background so the glass shows through.
DOTFILES_FZF_COLORS='--color=bg:-1,fg:{{fg}},hl:{{blue}} --color=bg+:{{surface}},fg+:{{fg}},hl+:{{blue}} --color=prompt:{{green}},pointer:{{magenta}},marker:{{green}} --color=info:{{yellow}},spinner:{{cyan}},header:{{cyan}},border:{{comment}}'

# eza: EZA_COLORS is what every eza build honours (Homebrew's ignores
# theme.yml), so the theme is expressed here too, as SGR truecolor triples.
# Keys: di=dir ln=symlink ex=executable pi=pipe so=socket bd/cd=devices
#       fi=file u*=permission bits g*=git status da=date uu/gu=user/group
export EZA_COLORS="di=38;2;{{blue:rgb}}:ln=38;2;{{cyan:rgb}}:ex=38;2;{{green:rgb}}:pi=38;2;{{yellow:rgb}}:so=38;2;{{magenta:rgb}}:bd=38;2;{{yellow:rgb}}:cd=38;2;{{yellow:rgb}}:fi=38;2;{{fg:rgb}}:ur=38;2;{{yellow:rgb}}:uw=38;2;{{vermilion:rgb}}:ux=38;2;{{green:rgb}}:gm=38;2;{{green:rgb}}:ga=38;2;{{yellow:rgb}}:gd=38;2;{{vermilion:rgb}}:da=38;2;{{comment:rgb}}:uu=38;2;{{fg:rgb}}:gu=38;2;{{comment:rgb}}"
