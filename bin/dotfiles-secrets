#!/usr/bin/env bash
#
# dotfiles-secrets - Secret management for dotfiles using age encryption
#
# Usage: dotfiles-secrets [COMMAND] [OPTIONS]
#
# Commands:
#   init        Initialize age key for this machine
#   encrypt     Encrypt a file
#   decrypt     Decrypt a file
#   edit        Edit an encrypted file
#   list        List encrypted files
#   status      Show encryption status
#
# This script uses 'age' for modern, secure encryption.
# Install: brew install age (macOS) or pacman -S age (Arch)
#

set -euo pipefail

readonly VERSION="1.0.0"
readonly SCRIPT_NAME="$(basename "$0")"

# Configuration
readonly AGE_KEY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/age"
readonly AGE_KEY_FILE="$AGE_KEY_DIR/key.txt"
readonly AGE_PUBKEY_FILE="$AGE_KEY_DIR/key.pub"
readonly SECRETS_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}/secrets"
readonly ENCRYPTED_EXT=".age"

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

# Helper functions
print_header() {
    echo -e "\n${BLUE}==>${NC} ${1}"
}

print_success() {
    echo -e "${GREEN}✓${NC} ${1}"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} ${1}"
}

print_error() {
    echo -e "${RED}✗${NC} ${1}"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if age is installed
check_age() {
    if ! command_exists age; then
        print_error "age is not installed"
        echo ""
        echo "Install age encryption tool:"
        echo "  macOS: brew install age"
        echo "  Arch:  pacman -S age"
        echo "  Other: https://github.com/FiloSottile/age#installation"
        exit 1
    fi
}

# Show usage
usage() {
    cat << EOF
Usage: $SCRIPT_NAME [COMMAND] [OPTIONS]

Manage encrypted secrets in your dotfiles repository.

Commands:
    init                Initialize age encryption key
    encrypt <file>      Encrypt a file (outputs to file.age)
    decrypt <file>      Decrypt a .age file
    edit <file>         Edit an encrypted file in place
    list                List all encrypted files
    status              Show encryption configuration status
    help                Show this help message

Options:
    -o, --output FILE   Specify output file (for encrypt/decrypt)
    -r, --recipient     Use specific recipient (public key)

Examples:
    $SCRIPT_NAME init
    $SCRIPT_NAME encrypt ~/.ssh/config
    $SCRIPT_NAME decrypt secrets/ssh-config.age
    $SCRIPT_NAME edit secrets/api-keys.age
    $SCRIPT_NAME list

EOF
}

# Initialize age key
cmd_init() {
    print_header "Initializing age encryption..."

    # Create key directory with secure permissions
    if [[ ! -d "$AGE_KEY_DIR" ]]; then
        mkdir -p "$AGE_KEY_DIR"
        chmod 700 "$AGE_KEY_DIR"
        print_success "Created key directory: $AGE_KEY_DIR"
    fi

    # Check for existing key
    if [[ -f "$AGE_KEY_FILE" ]]; then
        print_warning "Age key already exists at $AGE_KEY_FILE"
        read -p "Do you want to create a new key? This will NOT overwrite the existing one. [y/N] " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Keeping existing key."
            return
        fi

        # Backup existing key
        local backup="$AGE_KEY_FILE.bak.$(date +%Y%m%d%H%M%S)"
        cp "$AGE_KEY_FILE" "$backup"
        print_success "Backed up existing key to $backup"
    fi

    # Generate new key
    age-keygen -o "$AGE_KEY_FILE" 2>&1 | tee "$AGE_PUBKEY_FILE.tmp"

    # Extract public key
    grep "^# public key:" "$AGE_PUBKEY_FILE.tmp" | cut -d: -f2 | tr -d ' ' > "$AGE_PUBKEY_FILE"
    rm -f "$AGE_PUBKEY_FILE.tmp"

    # Secure the key file
    chmod 600 "$AGE_KEY_FILE"
    chmod 644 "$AGE_PUBKEY_FILE"

    print_success "Age key generated!"
    echo ""
    echo "Private key: $AGE_KEY_FILE (keep this safe!)"
    echo "Public key:  $(cat "$AGE_PUBKEY_FILE")"
    echo ""
    echo "Add this public key to other machines to share encrypted files."

    # Create secrets directory
    if [[ ! -d "$SECRETS_DIR" ]]; then
        mkdir -p "$SECRETS_DIR"
        print_success "Created secrets directory: $SECRETS_DIR"
    fi
}

# Encrypt a file
cmd_encrypt() {
    local input="$1"
    local output="${2:-}"

    if [[ -z "$input" ]]; then
        print_error "No input file specified"
        echo "Usage: $SCRIPT_NAME encrypt <file> [-o output]"
        exit 1
    fi

    if [[ ! -f "$input" ]]; then
        print_error "File not found: $input"
        exit 1
    fi

    # Check for key
    if [[ ! -f "$AGE_KEY_FILE" ]]; then
        print_error "No age key found. Run '$SCRIPT_NAME init' first."
        exit 1
    fi

    # Determine output file
    if [[ -z "$output" ]]; then
        output="${input}${ENCRYPTED_EXT}"
    fi

    # Get public key
    local pubkey
    pubkey=$(cat "$AGE_PUBKEY_FILE")

    # Encrypt
    print_header "Encrypting $input..."
    age -r "$pubkey" -o "$output" "$input"
    print_success "Encrypted to: $output"

    # Ask about removing original
    echo ""
    read -p "Remove original unencrypted file? [y/N] " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        rm "$input"
        print_success "Removed: $input"
    fi
}

# Decrypt a file
cmd_decrypt() {
    local input="$1"
    local output="${2:-}"

    if [[ -z "$input" ]]; then
        print_error "No input file specified"
        echo "Usage: $SCRIPT_NAME decrypt <file.age> [-o output]"
        exit 1
    fi

    if [[ ! -f "$input" ]]; then
        print_error "File not found: $input"
        exit 1
    fi

    # Check for key
    if [[ ! -f "$AGE_KEY_FILE" ]]; then
        print_error "No age key found. Cannot decrypt."
        exit 1
    fi

    # Determine output file
    if [[ -z "$output" ]]; then
        # Remove .age extension
        output="${input%$ENCRYPTED_EXT}"
        if [[ "$output" == "$input" ]]; then
            output="${input}.decrypted"
        fi
    fi

    # Decrypt
    print_header "Decrypting $input..."
    age -d -i "$AGE_KEY_FILE" -o "$output" "$input"
    print_success "Decrypted to: $output"
}

# Edit an encrypted file
cmd_edit() {
    local input="$1"

    if [[ -z "$input" ]]; then
        print_error "No file specified"
        echo "Usage: $SCRIPT_NAME edit <file.age>"
        exit 1
    fi

    if [[ ! -f "$input" ]]; then
        print_error "File not found: $input"
        exit 1
    fi

    # Check for key
    if [[ ! -f "$AGE_KEY_FILE" ]]; then
        print_error "No age key found. Cannot edit."
        exit 1
    fi

    # Create temp file with explicit template
    local tmpfile
    tmpfile=$(mktemp "${TMPDIR:-/tmp}/dotfiles-secret.XXXXXX")
    # Use shred if available, fall back to rm. Set trap BEFORE decrypting.
    cleanup_tmpfile() {
        if [[ -f "$tmpfile" ]]; then
            if command -v shred &>/dev/null; then
                shred -u "$tmpfile" 2>/dev/null
            else
                rm -f "$tmpfile"
            fi
        fi
    }
    trap cleanup_tmpfile EXIT INT TERM HUP

    # Decrypt to temp
    age -d -i "$AGE_KEY_FILE" -o "$tmpfile" "$input"

    # Portable SHA-256 checksum (macOS: shasum, Linux: sha256sum)
    _sha256() { shasum -a 256 "$1" 2>/dev/null || sha256sum "$1"; }

    # Get checksum before edit
    local checksum_before
    checksum_before=$(_sha256 "$tmpfile" | cut -d' ' -f1)

    # Edit with preferred editor
    local editor="${EDITOR:-vim}"
    "$editor" "$tmpfile"

    # Get checksum after edit
    local checksum_after
    checksum_after=$(_sha256 "$tmpfile" | cut -d' ' -f1)

    # Re-encrypt if changed
    if [[ "$checksum_before" != "$checksum_after" ]]; then
        local pubkey
        pubkey=$(cat "$AGE_PUBKEY_FILE")
        age -r "$pubkey" -o "$input" "$tmpfile"
        print_success "File updated and re-encrypted"
    else
        print_warning "No changes made"
    fi
}

# List encrypted files
cmd_list() {
    print_header "Encrypted files in repository..."
    echo ""

    local dotfiles_dir="${DOTFILES_DIR:-$HOME/.dotfiles}"

    if [[ -d "$dotfiles_dir" ]]; then
        local files
        files=$(find "$dotfiles_dir" -name "*${ENCRYPTED_EXT}" -type f 2>/dev/null || true)

        if [[ -n "$files" ]]; then
            echo "$files" | while read -r file; do
                local rel_path="${file#$dotfiles_dir/}"
                echo "  $rel_path"
            done
        else
            echo "  No encrypted files found"
        fi
    fi

    if [[ -d "$SECRETS_DIR" ]]; then
        echo ""
        echo "Secrets directory: $SECRETS_DIR"
        ls -la "$SECRETS_DIR" 2>/dev/null || echo "  (empty)"
    fi
}

# Show status
cmd_status() {
    print_header "Encryption Status"
    echo ""

    # Check age installation
    if command_exists age; then
        local age_version
        age_version=$(age --version 2>&1 | head -1)
        print_success "age installed: $age_version"
    else
        print_error "age not installed"
    fi

    # Check key file
    if [[ -f "$AGE_KEY_FILE" ]]; then
        print_success "Private key exists: $AGE_KEY_FILE"

        # Check permissions
        local perms
        perms=$(stat -c %a "$AGE_KEY_FILE" 2>/dev/null || stat -f %OLp "$AGE_KEY_FILE" 2>/dev/null)
        if [[ "$perms" == "600" ]]; then
            print_success "Key permissions correct (600)"
        else
            print_warning "Key permissions: $perms (should be 600)"
        fi
    else
        print_warning "No private key found"
        echo "    Run '$SCRIPT_NAME init' to create one"
    fi

    # Check public key
    if [[ -f "$AGE_PUBKEY_FILE" ]]; then
        print_success "Public key: $(cat "$AGE_PUBKEY_FILE")"
    fi

    # Count encrypted files
    local dotfiles_dir="${DOTFILES_DIR:-$HOME/.dotfiles}"
    local count
    count=$(find "$dotfiles_dir" -name "*${ENCRYPTED_EXT}" -type f 2>/dev/null | wc -l | tr -d ' ')
    echo ""
    echo "Encrypted files in repository: $count"
}

# Main function
main() {
    check_age

    local command="${1:-help}"
    shift || true

    case "$command" in
        init)
            cmd_init
            ;;
        encrypt)
            local output=""
            local input=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -o|--output)
                        output="$2"
                        shift 2
                        ;;
                    *)
                        input="$1"
                        shift
                        ;;
                esac
            done
            cmd_encrypt "$input" "$output"
            ;;
        decrypt)
            local output=""
            local input=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -o|--output)
                        output="$2"
                        shift 2
                        ;;
                    *)
                        input="$1"
                        shift
                        ;;
                esac
            done
            cmd_decrypt "$input" "$output"
            ;;
        edit)
            cmd_edit "${1:-}"
            ;;
        list)
            cmd_list
            ;;
        status)
            cmd_status
            ;;
        help|-h|--help)
            usage
            ;;
        version|-v|--version)
            echo "$SCRIPT_NAME version $VERSION"
            ;;
        *)
            print_error "Unknown command: $command"
            usage
            exit 1
            ;;
    esac
}

main "$@"
