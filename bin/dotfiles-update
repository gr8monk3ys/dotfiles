#!/usr/bin/env bash
# dotfiles-update - Update all packages and configurations

set -euo pipefail

# Default to the checkout this script lives in (works through symlinks), so
# running bin/dotfiles-* from any clone operates on that clone.
readonly DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly YELLOW='\033[1;33m'
readonly RED='\033[0;31m'
readonly NC='\033[0m' # No Color

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

print_header() {
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

# Update dotfiles repository
update_dotfiles() {
    print_header "Updating Dotfiles Repository"

    if [[ ! -d "$DOTFILES_DIR" ]]; then
        print_error "Dotfiles directory not found: $DOTFILES_DIR"
        return 1
    fi

    cd "$DOTFILES_DIR"

    if [[ ! -d ".git" ]]; then
        print_error "Not a git repository"
        return 1
    fi

    # Check for uncommitted changes
    if [[ -n $(git status --porcelain) ]]; then
        print_error "Uncommitted changes detected. Commit or stash changes first."
        git status --short
        return 1
    fi

    print_info "Fetching updates..."
    if git fetch origin; then
        # Check if we're behind
        LOCAL=$(git rev-parse @)
        REMOTE=$(git rev-parse '@{u}' 2>/dev/null || echo "$LOCAL")
        BASE=$(git merge-base @ '@{u}' 2>/dev/null || echo "$LOCAL")

        if [[ "$LOCAL" = "$REMOTE" ]]; then
            print_success "Already up to date"
        elif [[ "$LOCAL" = "$BASE" ]]; then
            print_info "Pulling changes..."
            git pull --rebase
            print_success "Updated successfully"
        else
            print_error "Local and remote have diverged. Manual merge required."
            return 1
        fi
    else
        print_error "Failed to fetch updates"
        return 1
    fi
}

# Update Homebrew packages
update_homebrew() {
    print_header "Updating Homebrew"

    if ! command_exists brew; then
        print_info "Homebrew not installed, skipping..."
        return 0
    fi

    print_info "Updating Homebrew itself..."
    brew update

    print_info "Upgrading formulae..."
    brew upgrade

    print_info "Upgrading casks..."
    brew upgrade --cask --greedy

    print_info "Cleaning up..."
    brew cleanup

    print_info "Running brew doctor..."
    if brew doctor; then
        print_success "Homebrew updated successfully"
    else
        print_error "Brew doctor found issues"
    fi
}

# Update npm packages
update_npm() {
    print_header "Updating npm Packages"

    if ! command_exists npm; then
        print_info "npm not installed, skipping..."
        return 0
    fi

    print_info "Updating npm itself..."
    npm install -g npm@latest

    print_info "Checking for outdated packages..."
    # npm outdated exits 1 when packages are outdated; without the
    # || true, set -e would abort exactly when there is work to do.
    outdated=$(npm outdated -g --depth=0 | tail -n +2 | wc -l | tr -d '[:space:]') || true

    if [[ "$outdated" -gt 0 ]]; then
        print_info "Updating $outdated global packages..."
        npm update -g
        print_success "npm packages updated"
    else
        print_success "All npm packages up to date"
    fi
}

# Update Cargo packages
update_cargo() {
    print_header "Updating Cargo Packages"

    if ! command_exists cargo; then
        print_info "Cargo not installed, skipping..."
        return 0
    fi

    # Check if cargo-update is installed
    if ! command_exists cargo-install-update; then
        print_info "Installing cargo-update..."
        cargo install cargo-update
    fi

    print_info "Updating Rust toolchain..."
    if command_exists rustup; then
        rustup update
    fi

    print_info "Updating cargo packages..."
    cargo install-update -a

    print_success "Cargo packages updated"
}

# Update Zinit and its plugins
update_zinit() {
    print_header "Updating Zinit"

    local zinit_home="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"

    if [[ ! -d "$zinit_home" ]]; then
        print_info "Zinit not installed, skipping..."
        return 0
    fi

    print_info "Updating Zinit and plugins..."
    # Source zinit.zsh directly in a non-interactive zsh: zinit update
    # works from the on-disk plugin store, and skipping .zshrc avoids
    # loading the full interactive setup (p10k instant prompt, atuin).
    if env ZINIT_HOME="$zinit_home" zsh -c \
        'source "$ZINIT_HOME/zinit.zsh" && zinit self-update && zinit update --all'; then
        print_success "Zinit and plugins updated"
    else
        print_error "Zinit update failed"
    fi
}

# Update Neovim plugins
update_nvim() {
    print_header "Updating Neovim Plugins"

    if ! command_exists nvim; then
        print_info "Neovim not installed, skipping..."
        return 0
    fi

    print_info "Updating Neovim plugins..."
    # This depends on your plugin manager
    # For lazy.nvim:
    if nvim --headless "+Lazy! sync" +qa 2>/dev/null; then
        print_success "Neovim plugins updated"
    else
        print_info "Plugin update command may have failed (check manually)"
    fi
}

# Generate update report
generate_report() {
    print_header "Update Summary"

    echo ""
    print_success "Update complete!"
    echo ""
    print_info "Run 'dotfiles-doctor' to check system health"
    echo ""
}

# Show help message
show_help() {
    cat << EOF
Usage: dotfiles-update [OPTIONS]

Update all packages, configurations, and tools in the dotfiles system.

OPTIONS:
    -h, --help      Show this help message
    -v, --verbose   Show verbose output during updates
    --skip-brew     Skip Homebrew updates
    --skip-npm      Skip npm updates
    --skip-cargo    Skip Cargo updates

DESCRIPTION:
    Updates the following:
    - Dotfiles repository (git pull)
    - Homebrew packages (formulae and casks)
    - npm global packages
    - Cargo packages
    - Zinit and its zsh plugins
    - Neovim plugins

REQUIREMENTS:
    - Clean git repository (no uncommitted changes)
    - Internet connection

EXAMPLES:
    dotfiles-update              Update everything
    dotfiles-update --help       Show this help
    dotfiles-update --verbose    Update with detailed output
    dotfiles-update --skip-brew  Skip Homebrew updates

EOF
}

# Main
main() {
    local skip_brew=false
    local skip_npm=false
    local skip_cargo=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                set -x
                shift
                ;;
            --skip-brew)
                skip_brew=true
                shift
                ;;
            --skip-npm)
                skip_npm=true
                shift
                ;;
            --skip-cargo)
                skip_cargo=true
                shift
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done

    echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║                    Dotfiles Updater                           ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"

    # Update dotfiles repository first
    update_dotfiles || {
        print_error "Failed to update dotfiles repository"
        exit 1
    }

    # Update package managers
    [[ "$skip_brew" == false ]] && update_homebrew
    [[ "$skip_npm" == false ]] && update_npm
    [[ "$skip_cargo" == false ]] && update_cargo

    # Update shell and editor
    update_zinit
    update_nvim

    # Generate report
    generate_report
}

main "$@"
