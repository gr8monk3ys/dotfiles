# monochrome-43 - Ghostty's view of .config/palette/monochrome-43.conf.
#
# 43PR/dotfiles' terminal colours (MIT): pure black ground, white text, and
# the ANSI slots 43PR's kitty used. Slot 0 is the ground and slot 15 is fg,
# so a TUI that paints "black" or "bright white" stays in the monochrome.
#
# The default: the config says `theme = monochrome-43`. `theme = danse` in
# ~/.config/ghostty/config.local (gitignored; included last) opts back out.
#
# Every hex below must be a palette colour; test_palette.bats asserts it.

palette = 0=#000000
palette = 1=#cc0403
palette = 2=#e2e2e2
palette = 3=#cecb00
palette = 4=#0d73cc
palette = 5=#cb1ed1
palette = 6=#0dcdcd
palette = 7=#dddddd
palette = 8=#767676
palette = 9=#f2201f
palette = 10=#23fd00
palette = 11=#fffd00
palette = 12=#1a8fff
palette = 13=#fd28ff
palette = 14=#14ffff
palette = 15=#ffffff

background = #000000
foreground = #ffffff
cursor-color = #cccccc
cursor-text = #111111
selection-background = #2a2a2a
selection-foreground = #ffffff
