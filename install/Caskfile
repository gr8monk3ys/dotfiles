# Homebrew Caskfile — day-one desktop
# GUI applications a fresh macOS machine needs before it is usable.
# Applied by `make cask-apps` (part of `make macos`).
# Everything optional lives in Caskfile.extra (`make cask-apps-extra`).
# Install by hand with: brew bundle --file=install/Caskfile

# ============================================================================
# Window Management & System Utilities
# ============================================================================
cask "aerospace"                       # i3-like tiling window manager for macOS
cask "karabiner-elements"              # Keyboard customization and remapping
cask "raycast"                         # Spotlight replacement with extensions

# ============================================================================
# Terminals
# ============================================================================
cask "ghostty"                         # Zig-based GPU-accelerated terminal (primary)

# ============================================================================
# Web Browsers
# ============================================================================
cask "zen"                             # Zen browser (privacy-focused, primary)
cask "firefox"                         # Mozilla Firefox web browser
cask "brave-browser"                   # Privacy-focused Chromium browser

# ============================================================================
# Development Tools
# ============================================================================
cask "vscodium"                        # Open-source VS Code without telemetry
cask "docker-desktop"                  # Docker Desktop (containers + Docker CLI)

# ============================================================================
# Notes, Security & Sync
# ============================================================================
cask "obsidian"                        # Markdown-based knowledge base
cask "keepassxc"                       # Password manager
cask "proton-drive"                    # End-to-end encrypted cloud storage
cask "proton-mail-bridge"              # IMAP/SMTP bridge for Proton Mail (neomutt, himalaya)

# ============================================================================
# Communication
# ============================================================================
cask "discord"                         # Discord (the Discord MCP server talks to it)

# ============================================================================
# Graphics
# ============================================================================
cask "gimp"                            # Raster image editor (gimp-mcp drives it)
cask "inkscape"                        # Vector graphics editor

# ============================================================================
# Music
# ============================================================================
cask "tidal"                           # Music streaming service
cask "spotify"                         # Spotify client (themed by spicetify-cli)

# ============================================================================
# Fonts
# ============================================================================
cask "font-jetbrains-mono-nerd-font"   # JetBrains Mono Nerd Font (Ghostty's font)
cask "font-fira-code-nerd-font"        # Fira Code Nerd Font (ligature support)
