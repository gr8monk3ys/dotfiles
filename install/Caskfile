# Homebrew Caskfile
# GUI applications for macOS
# Install with: brew bundle --file=install/Caskfile --cask

# ============================================================================
# Window Management & System Utilities
# ============================================================================
cask "aerospace"                       # i3-like tiling window manager for macOS
cask "karabiner-elements"              # Keyboard customization and remapping
cask "raycast"                         # Spotlight replacement with extensions
cask "keycastr"                        # Keystroke visualizer for presentations

# ============================================================================
# Terminals & Terminal Tools
# ============================================================================
cask "ghostty"                         # Zig-based GPU-accelerated terminal (modern, fast)
cask "kitty"                           # GPU-accelerated terminal emulator (backup)

# ============================================================================
# Web Browsers
# ============================================================================
cask "firefox"                         # Mozilla Firefox web browser
cask "brave-browser"                   # Privacy-focused Chromium browser
cask "zen"                             # Zen browser (privacy-focused)
cask "tor-browser"                     # Anonymous web browser

# ============================================================================
# Development Tools & IDEs
# ============================================================================
cask "vscodium"                        # Open-source VS Code without telemetry
cask "db-browser-for-sqlite"           # SQLite database browser

# ============================================================================
# Design & Creative Tools
# ============================================================================
cask "figma"                           # Interface design and prototyping
cask "godot"                           # Open-source game engine

# ============================================================================
# Media Creation & Editing
# ============================================================================
cask "audacity"                        # Audio editing software
cask "obs"                             # Open Broadcaster Software (streaming/recording)
cask "rode-central"                    # Rode microphone control software

# ============================================================================
# Media Players & Music
# ============================================================================
cask "tidal"                           # Music streaming service

# ============================================================================
# Note-Taking & Knowledge Management
# ============================================================================
cask "obsidian"                        # Markdown-based knowledge base

# ============================================================================
# Productivity & Organization
# ============================================================================
cask "spacedrive"                      # Cross-platform file manager

# ============================================================================
# Security & Privacy
# ============================================================================
cask "keepassxc"                       # Password manager
cask "proton-drive"                    # End-to-end encrypted cloud storage
cask "monero-wallet"                   # Cryptocurrency wallet

# ============================================================================
# Communication
# ============================================================================
cask "dorion"                          # Discord client alternative

# ============================================================================
# System Utilities & Tools
