# Generated by bin/rice-themes from .config/palette/templates/zsh.zsh
# for the monochrome-43 rice. Edit the template, then `bin/rice-themes render`.
#
# The shell's own colours. Sourced by .config/zsh/rice.zsh, after the
# plugins are loaded: zsh-syntax-highlighting and zsh-autosuggestions read
# these at draw time, and .zshrc folds DOTFILES_FZF_COLORS into
# FZF_DEFAULT_OPTS (fzf-tab, ctrl-r/ctrl-t and fzf-based scripts inherit it).

# Valid commands in the success colour, errors in the error colour, paths
# underlined in the accent.
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#c2c2c2'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#c2c2c2'
ZSH_HIGHLIGHT_STYLES[function]='fg=#c2c2c2'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#c2c2c2'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#c2c2c2,italic'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#ffffff'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ff003c'
ZSH_HIGHLIGHT_STYLES[path]='fg=#7aa2f7,underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#8b93a7'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#f7768e'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#f7768e'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#f7768e'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#6f6f6f,italic'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#ffffff'

# The ghost text after the cursor: the comment colour, like a code comment.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6f6f6f'

# fzf; bg:-1 keeps the terminal's own background so the glass shows through.
DOTFILES_FZF_COLORS='--color=bg:-1,fg:#e6eaf2,hl:#7aa2f7 --color=bg+:#2a2a2a,fg+:#e6eaf2,hl+:#7aa2f7 --color=prompt:#c2c2c2,pointer:#ffffff,marker:#c2c2c2 --color=info:#f7768e,spinner:#8b93a7,header:#8b93a7,border:#6f6f6f'

# eza: EZA_COLORS is what every eza build honours (Homebrew's ignores
# theme.yml), so the theme is expressed here too, as SGR truecolor triples.
# Keys: di=dir ln=symlink ex=executable pi=pipe so=socket bd/cd=devices
#       fi=file u*=permission bits g*=git status da=date uu/gu=user/group
export EZA_COLORS="di=38;2;122;162;247:ln=38;2;139;147;167:ex=38;2;194;194;194:pi=38;2;247;118;142:so=38;2;255;255;255:bd=38;2;247;118;142:cd=38;2;247;118;142:fi=38;2;230;234;242:ur=38;2;247;118;142:uw=38;2;255;0;60:ux=38;2;194;194;194:gm=38;2;194;194;194:ga=38;2;247;118;142:gd=38;2;255;0;60:da=38;2;111;111;111:uu=38;2;230;234;242:gu=38;2;111;111;111"
